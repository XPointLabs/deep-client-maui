<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
      <certificates src="@raw/deep_physical_uat_ca" />
    </trust-anchors>
  </base-config>
  <!-- CRLs are CA-signed integrity objects. This exception is physical-UAT only;
       every application service endpoint remains HTTPS-only in code and profile. -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">192.168.1.43</domain>
  </domain-config>
</network-security-config>
