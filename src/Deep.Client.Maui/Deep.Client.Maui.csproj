<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Deep.Client.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Deep</ApplicationTitle>
    <ApplicationId>network.xpoint.deep</ApplicationId>
    <ApplicationDisplayVersion>0.2.3</ApplicationDisplayVersion>
    <ApplicationVersion>7</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</TargetPlatformMinVersion>
    <EmbedAssembliesIntoApk Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">true</EmbedAssembliesIntoApk>
    <NoWarn Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">$(NoWarn);BG8403</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidPackageFormats>aab</AndroidPackageFormats>
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <AndroidEnableProguard>true</AndroidEnableProguard>
    <AndroidLinkTool>r8</AndroidLinkTool>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <ProjectReference Include="..\Deep.Client.Maui.Core\Deep.Client.Maui.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="Xamarin.Firebase.Messaging" Version="124.1.2" />
    <GoogleServicesJson Include="Platforms\Android\google-services.json" Condition="Exists('Platforms\Android\google-services.json')" />
  </ItemGroup>

  <ItemGroup>
    <None Include="deep.release.env">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="deep.release.env">
      <LogicalName>deep.release.env</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="deep.bootstrap.json">
      <LogicalName>deep.bootstrap.json</LogicalName>
    </EmbeddedResource>
    <MauiAsset Remove="Resources\Raw\geolite2_country_blocks_ipv4" />
    <MauiAsset Remove="Resources\Raw\geolite2_country_codes.json" />
    <MauiAsset Include="Resources\Raw\wwwroot\**" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\Raw\geolite2_country_blocks_ipv4">
      <LogicalName>geolite2_country_blocks_ipv4</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Raw\geolite2_country_codes.json">
      <LogicalName>geolite2_country_codes.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidLibrary Include="Platforms\Android\Jars\libXray.aar" />
    <ProguardConfiguration Include="Platforms\Android\proguard.cfg" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" BaseSize="512,512" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#020711" BaseSize="160,160" />
    <MauiImage Include="Resources\Images\xpoint_logo.png" Resize="True" BaseSize="256,256" />
    <MauiImage Include="Resources\Images\deep_logo.png" Resize="True" BaseSize="512,512" />
    <MauiImage Include="Resources\Images\deep_mark.png" Resize="True" BaseSize="256,256" />
    <MauiImage Include="Resources\Images\app_icon_*.png" Resize="True" BaseSize="256,256" />
  </ItemGroup>

  <Target Name="EnsureGoogleServicesJson" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and !Exists('Platforms\Android\google-services.json')">
    <Error Text="Production Android builds require Platforms\Android\google-services.json. Use eng/build-android-play.ps1 with XPOINT_GOOGLE_SERVICES_JSON." />
  </Target>

</Project>
