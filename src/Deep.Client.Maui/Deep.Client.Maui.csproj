<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Deep.Client.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Deep</ApplicationTitle>
    <DeepLocalDev Condition="'$(DeepLocalDev)' == ''">false</DeepLocalDev>
    <DeepDid2AccountProbe Condition="'$(DeepDid2AccountProbe)' == ''">false</DeepDid2AccountProbe>
    <ApplicationId Condition="('$(DeepPhysicalE2E)' != 'true' And '$(DeepLocalDev)' != 'true') Or '$(Configuration)' == 'Release'">network.xpoint.deep</ApplicationId>
    <ApplicationId Condition="('$(DeepPhysicalE2E)' == 'true' Or '$(DeepLocalDev)' == 'true') And '$(Configuration)' != 'Release'">network.xpoint.deep.e2e</ApplicationId>
    <ApplicationId Condition="'$(DeepDid2AccountProbe)' == 'true' And '$(DeepLocalDev)' == 'true' And '$(Configuration)' != 'Release'">network.xpoint.deep.did2probe</ApplicationId>
    <ApplicationTitle Condition="'$(DeepDid2AccountProbe)' == 'true' And '$(DeepLocalDev)' == 'true' And '$(Configuration)' != 'Release'">Deep DID2 UAT</ApplicationTitle>
    <ApplicationDisplayVersion>0.2.9</ApplicationDisplayVersion>
    <ApplicationVersion>16</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">28.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</TargetPlatformMinVersion>
    <EmbedAssembliesIntoApk Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">true</EmbedAssembliesIntoApk>
    <NoWarn>$(NoWarn);NU1608</NoWarn>
    <NoWarn Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">$(NoWarn);BG8403</NoWarn>
    <ProductionMailboxTrustFloorSupplied Condition="'$(DeepProductionMrXPublicKeySha256)$(DeepProductionNetworkId)$(DeepProductionAuthorityGeneration)$(DeepProductionAuthorityHash)$(DeepProductionRevocationGeneration)$(DeepProductionRevocationHeadHash)$(DeepProductionRevocationSnapshotHash)$(DeepProductionTopologyGeneration)$(DeepProductionTopologyHash)' != ''">true</ProductionMailboxTrustFloorSupplied>
    <ProductionAndroidBuildIdentitySupplied Condition="'$(DeepProductionAndroidApplicationId)$(DeepProductionAndroidVersionCode)$(DeepProductionAndroidSignerLineageSha256)' != ''">true</ProductionAndroidBuildIdentitySupplied>
    <ProductionAndroidTransparencySupplied Condition="'$(DeepProductionAndroidCodeTransparencyManifest)' != ''">true</ProductionAndroidTransparencySupplied>
    <PhysicalUatMailboxTrustFloorSupplied Condition="'$(DeepPhysicalUatMrXPublicKeySha256)$(DeepPhysicalUatNetworkId)$(DeepPhysicalUatAuthorityGeneration)$(DeepPhysicalUatAuthorityHash)$(DeepPhysicalUatRevocationGeneration)$(DeepPhysicalUatRevocationHeadHash)$(DeepPhysicalUatRevocationSnapshotHash)$(DeepPhysicalUatTopologyGeneration)$(DeepPhysicalUatTopologyHash)' != ''">true</PhysicalUatMailboxTrustFloorSupplied>
    <PhysicalUatAndroidBuildIdentitySupplied Condition="'$(DeepPhysicalUatAndroidApplicationId)$(DeepPhysicalUatAndroidVersionCode)$(DeepPhysicalUatAndroidSignerLineageSha256)' != ''">true</PhysicalUatAndroidBuildIdentitySupplied>
    <PhysicalUatAndroidTransparencySupplied Condition="'$(DeepPhysicalUatAndroidCodeTransparencyManifest)' != ''">true</PhysicalUatAndroidTransparencySupplied>
    <PhysicalUatWindowsBuildIdentitySupplied Condition="'$(DeepPhysicalUatWindowsPackageName)$(DeepPhysicalUatWindowsPublisher)$(DeepPhysicalUatWindowsSigningCertificateSha256)' != ''">true</PhysicalUatWindowsBuildIdentitySupplied>
    <DeepDevelopmentNetworkId Condition="'$(Configuration)' != 'Release' And '$(DeepPhysicalE2E)' != 'true' And '$(DeepDevelopmentNetworkId)' == ''">3e078ce750768322d79079ef97b85b56</DeepDevelopmentNetworkId>
    <DeepPhysicalUatNetworkId Condition="'$(DeepLocalDev)' == 'true' And '$(Configuration)' != 'Release' And '$(DeepPhysicalUatNetworkId)' == ''">$(DeepDevelopmentNetworkId)</DeepPhysicalUatNetworkId>
    <DeepMrXPublicKeySha256 Condition="'$(DeepLocalDev)' == 'true' And '$(Configuration)' != 'Release' And '$(DeepMrXPublicKeySha256)' == ''">1111111111111111111111111111111111111111111111111111111111111111</DeepMrXPublicKeySha256>
    <DeepGoogleServicesJson Condition="'$(DeepGoogleServicesJson)' == '' And '$(Configuration)' != 'Release'">Platforms\Android\google-services.json</DeepGoogleServicesJson>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="DeepDevelopmentNetworkId" Value="$(DeepDevelopmentNetworkId)" />
    <AssemblyMetadata Include="DeepProductionMrXPublicKeySha256" Value="$(DeepProductionMrXPublicKeySha256)" />
    <AssemblyMetadata Include="DeepProductionNetworkId" Value="$(DeepProductionNetworkId)" />
    <AssemblyMetadata Include="DeepProductionAuthorityGeneration" Value="$(DeepProductionAuthorityGeneration)" />
    <AssemblyMetadata Include="DeepProductionAuthorityHash" Value="$(DeepProductionAuthorityHash)" />
    <AssemblyMetadata Include="DeepProductionRevocationGeneration" Value="$(DeepProductionRevocationGeneration)" />
    <AssemblyMetadata Include="DeepProductionRevocationHeadHash" Value="$(DeepProductionRevocationHeadHash)" />
    <AssemblyMetadata Include="DeepProductionRevocationSnapshotHash" Value="$(DeepProductionRevocationSnapshotHash)" />
    <AssemblyMetadata Include="DeepProductionTopologyGeneration" Value="$(DeepProductionTopologyGeneration)" />
    <AssemblyMetadata Include="DeepProductionTopologyHash" Value="$(DeepProductionTopologyHash)" />
    <AssemblyMetadata Include="DeepProductionAndroidApplicationId" Value="$(DeepProductionAndroidApplicationId)" />
    <AssemblyMetadata Include="DeepProductionAndroidVersionCode" Value="$(DeepProductionAndroidVersionCode)" />
    <AssemblyMetadata Include="DeepProductionAndroidSignerLineageSha256" Value="$(DeepProductionAndroidSignerLineageSha256)" />
    <AssemblyMetadata Include="DeepCiReleaseCandidate" Value="$(DeepCiReleaseCandidate)" />
  </ItemGroup>

  <ItemGroup Condition="('$(DeepPhysicalE2E)' == 'true' Or '$(DeepLocalDev)' == 'true') And '$(Configuration)' != 'Release'">
    <AssemblyMetadata Include="DeepPhysicalUatMrXPublicKeySha256" Value="$(DeepPhysicalUatMrXPublicKeySha256)" />
    <AssemblyMetadata Include="DeepPhysicalUatNetworkId" Value="$(DeepPhysicalUatNetworkId)" />
    <AssemblyMetadata Include="DeepPhysicalUatAuthorityGeneration" Value="$(DeepPhysicalUatAuthorityGeneration)" />
    <AssemblyMetadata Include="DeepPhysicalUatAuthorityHash" Value="$(DeepPhysicalUatAuthorityHash)" />
    <AssemblyMetadata Include="DeepPhysicalUatRevocationGeneration" Value="$(DeepPhysicalUatRevocationGeneration)" />
    <AssemblyMetadata Include="DeepPhysicalUatRevocationHeadHash" Value="$(DeepPhysicalUatRevocationHeadHash)" />
    <AssemblyMetadata Include="DeepPhysicalUatRevocationSnapshotHash" Value="$(DeepPhysicalUatRevocationSnapshotHash)" />
    <AssemblyMetadata Include="DeepPhysicalUatTopologyGeneration" Value="$(DeepPhysicalUatTopologyGeneration)" />
    <AssemblyMetadata Include="DeepPhysicalUatTopologyHash" Value="$(DeepPhysicalUatTopologyHash)" />
    <AssemblyMetadata Include="DeepPhysicalUatAndroidApplicationId" Value="$(DeepPhysicalUatAndroidApplicationId)" />
    <AssemblyMetadata Include="DeepPhysicalUatAndroidVersionCode" Value="$(DeepPhysicalUatAndroidVersionCode)" />
    <AssemblyMetadata Include="DeepPhysicalUatAndroidSignerLineageSha256" Value="$(DeepPhysicalUatAndroidSignerLineageSha256)" />
    <AssemblyMetadata Include="DeepPhysicalUatWindowsPackageName" Value="$(DeepPhysicalUatWindowsPackageName)" />
    <AssemblyMetadata Include="DeepPhysicalUatWindowsPublisher" Value="$(DeepPhysicalUatWindowsPublisher)" />
    <AssemblyMetadata Include="DeepPhysicalUatWindowsSigningCertificateSha256" Value="$(DeepPhysicalUatWindowsSigningCertificateSha256)" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(ProductionAndroidTransparencySupplied)' == 'true'">
    <AndroidAsset Include="$(DeepProductionAndroidCodeTransparencyManifest)"
                  Link="deep/production/android-code-transparency.act1" />
  </ItemGroup>

  <ItemGroup Condition="'$(DeepPhysicalE2E)' == 'true' And '$(Configuration)' != 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(PhysicalUatAndroidTransparencySupplied)' == 'true'">
    <AndroidAsset Include="$(DeepPhysicalUatAndroidCodeTransparencyManifest)"
                  Link="deep/production/android-code-transparency.act1" />
  </ItemGroup>

  <PropertyGroup Condition="('$(DeepPhysicalE2E)' == 'true' Or '$(DeepLocalDev)' == 'true') And '$(Configuration)' != 'Release'">
    <DefineConstants>$(DefineConstants);DEEP_PHYSICAL_E2E</DefineConstants>
    <PhysicalLabTrustRootSource>$(BaseIntermediateOutputPath)deep-physical\$(TargetFramework)\$(RuntimeIdentifier)\PhysicalLabTrustRoot.g.cs</PhysicalLabTrustRootSource>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DeepDid2AccountProbe)' == 'true' And '$(DeepLocalDev)' == 'true' And '$(Configuration)' != 'Release'">
    <DefineConstants>$(DefineConstants);DEEP_DID2_ACCOUNT_PROBE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DeepDid2CanaryAdmission)' == 'true' And '$(DeepDid2AccountProbe)' == 'true' And '$(DeepLocalDev)' == 'true' And '$(Configuration)' != 'Release'">
    <DefineConstants>$(DefineConstants);DEEP_DID2_CANARY_ADMISSION</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(DeepDid2CanaryAdmission)' == 'true' And '$(DeepDid2AccountProbe)' == 'true' And '$(DeepLocalDev)' == 'true' And '$(Configuration)' != 'Release'">
    <AssemblyMetadata Include="DeepDid2CanaryOrigin" Value="$(DeepDid2CanaryOrigin)" />
    <AssemblyMetadata Include="DeepDid2CanaryXna1Pin" Value="$(DeepDid2CanaryXna1Pin)" />
    <AssemblyMetadata Include="DeepDid2CanaryAdh1Pin" Value="$(DeepDid2CanaryAdh1Pin)" />
    <MauiAsset Include="$(DeepDid2BootstrapDirectory)\xna1.0000.bin" LogicalName="did2_xna1.bin" />
    <MauiAsset Include="$(DeepDid2BootstrapDirectory)\dts1.0000.bin" LogicalName="did2_dts1.bin" />
    <MauiAsset Include="$(DeepDid2BootstrapDirectory)\did2-genesis-adh1.bin" LogicalName="did2_adh1.bin" />
  </ItemGroup>

  <Target Name="RejectUnsafeDid2AccountProbe" BeforeTargets="PrepareForBuild"
          Condition="'$(DeepDid2AccountProbe)' == 'true' And ('$(DeepLocalDev)' != 'true' Or '$(Configuration)' == 'Release')">
    <Error Text="DID2 account probe requires a non-Release DeepLocalDev build." />
  </Target>

  <Target Name="RejectUnsafeDid2CanaryAdmission" BeforeTargets="PrepareForBuild"
          Condition="'$(DeepDid2CanaryAdmission)' == 'true'">
    <Error Condition="'$(DeepDid2AccountProbe)' != 'true' Or '$(DeepLocalDev)' != 'true' Or '$(Configuration)' == 'Release'"
           Text="DID2 canary admission is available only in a non-Release isolated account probe." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeepDid2CanaryOrigin)', '^http://127\.0\.0\.1:[0-9]{1,5}/$'))"
           Text="DID2 canary admission requires an explicit loopback tunnel origin." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeepDid2CanaryXna1Pin)', '^[0-9a-f]{64}$')) Or !$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeepDid2CanaryAdh1Pin)', '^[0-9a-f]{64}$'))"
           Text="DID2 canary admission requires exact lowercase public bootstrap pins." />
    <Error Condition="'$(DeepDid2BootstrapDirectory)' == '' Or !Exists('$(DeepDid2BootstrapDirectory)\xna1.0000.bin') Or !Exists('$(DeepDid2BootstrapDirectory)\dts1.0000.bin') Or !Exists('$(DeepDid2BootstrapDirectory)\did2-genesis-adh1.bin')"
           Text="DID2 canary admission requires the three exact signed public bootstrap assets." />
  </Target>

  <ItemGroup Condition="('$(DeepPhysicalE2E)' == 'true' Or '$(DeepLocalDev)' == 'true') And '$(Configuration)' != 'Release'">
    <Compile Include="$(PhysicalLabTrustRootSource)" Visible="false" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <AndroidEnableProguard>true</AndroidEnableProguard>
    <AndroidLinkTool>r8</AndroidLinkTool>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifierOverride)' != ''">
    <RuntimeIdentifier>$(RuntimeIdentifierOverride)</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <ProjectReference Include="..\Deep.Client.Maui.Core\Deep.Client.Maui.Core.csproj" />
    <ProjectReference Include="..\..\..\deep-client-shared\src\Deep.Client.Shared\Deep.Client.Shared.Production.csproj"
                      GlobalPropertiesToRemove="RuntimeIdentifier;RuntimeIdentifiers;SelfContained" />
  </ItemGroup>

  <!--
    Clean-break client composition.  The removed files are the pre-cutover
    Session-derived shell/runtime and are retained only as offline source
    evidence until the repository cleanup commit deletes them.  They are not
    compiled, packaged, reflected or used as a compatibility path.
  -->
  <ItemGroup>
    <MauiXaml Remove="App.xaml;AppShell.xaml;Pages\**\*.xaml;Styles\**\*.xaml" />
    <Compile Remove="App.xaml.cs;AppShell.xaml.cs;MauiProgram.cs;DesktopWorkspaceContracts.cs" />
    <Compile Remove="Controls\**\*.cs;Pages\**\*.xaml.cs" />
    <Compile Remove="Services\ApplicationHttpTransportComposition.cs" />
    <Compile Remove="Services\BackgroundSyncSchedulingCoordinator.cs" />
    <Compile Remove="Services\CallSessionCoordinator.cs" />
    <Compile Remove="Services\ClientRuntimeBootstrapper.cs" />
    <Compile Remove="Services\ContactInvitationProvider.cs" />
    <Compile Remove="Services\ContactAvatarStore.cs" />
    <Compile Remove="Services\ContactProfileUpdateBus.cs" />
    <Compile Remove="Services\DevelopmentMailboxHolderBootstrap.cs" />
    <Compile Remove="Services\IncomingMessageNotificationCoordinator.cs" />
    <Compile Remove="Services\MauiAccountLogoutCoordinator.cs" />
    <Compile Remove="Services\MauiAttachmentPickerService.cs" />
    <Compile Remove="Services\ProductionMailboxArtifactSetDigest.cs" />
    <Compile Remove="Services\MauiPushNotificationService.cs" />
    <Compile Remove="Services\MailboxRuntimeProvisioning.cs" />
    <Compile Remove="Services\PersistentClientRuntimeComposer.cs" />
    <Compile Remove="Services\PlatformBoundaryImplementations.cs" />
    <Compile Remove="Services\PhysicalE2eAckCorrelationProvider.cs" />
    <Compile Remove="Services\PhysicalE2eMessageDispatchFailureObserver.cs" />
    <Compile Remove="Services\PhysicalMailboxRouteUsageTracker.cs" />
    <Compile Remove="Services\ProductionMailboxContactStateStore.cs" />
    <Compile Remove="Services\ProductionMailboxBuildTrustFloor.cs" />
    <Compile Remove="Services\ProductionMailboxClientIdentityAttestor.cs" />
    <Compile Remove="Services\ProductionMailboxCredentialAcquirer.cs" />
    <Compile Remove="Services\ProductionMailboxLocalOwnerLifecycle.cs" />
    <Compile Remove="Services\ProductionMailboxOwnerIdentityStore.cs" />
    <Compile Remove="Services\ProductionMailboxRegistryClient.cs" />
    <Compile Remove="Services\ProductionMailboxRegistryJsonCodec.cs" />
    <Compile Remove="Services\ProtectedProductionMailboxTrustStateStore.cs" />
    <Compile Remove="Services\ProductionMailboxRuntimeCoordinator.cs" />
    <Compile Remove="Services\PushNotificationSecureStorage.cs" />
    <Compile Remove="Services\PushNotificationKeyStateCodec.cs" />
    <Compile Remove="Services\PushNotificationReplayCache.cs" />
    <Compile Remove="Services\PushTokenBridge.cs" />
    <Compile Remove="Services\PushRegistrationLifecycleCoordinator.cs" />
    <Compile Remove="Services\PushUnsubscribeRetryBootstrapper.cs" />
    <Compile Remove="Services\PushUnsubscribeRetryStateCodec.cs" />
    <Compile Remove="Services\SyncPollingPolicy.cs" />
    <Compile Remove="Services\SecureRecoverySessionStore.cs" />
    <Compile Remove="Services\StoreBoundNativeMau2Transport.cs" />
    <Compile Remove="Services\RuntimeTransportMode.cs" />
    <Compile Remove="Platforms\Android\DeepFirebaseMessagingService.cs" />
    <Compile Remove="Platforms\Android\DeepSyncJobService.cs" />
    <Compile Remove="Platforms\Android\FirebaseTokenProvider.cs" />
    <Compile Remove="Platforms\Android\ShareIngressActivity.cs" />
    <Compile Remove="Platforms\Windows\WindowsPushNotificationService.cs" />
    <Compile Remove="Platforms\Windows\WindowsShareTargetService.cs" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidAsset Include="..\..\..\deep-protocol\src\Deep.Protocol\runtimes\android-arm64\native\libdeep_mlkem.so"
                  Link="deep-native\libdeep_mlkem.so" />
    <AndroidAsset Include="..\..\..\deep-protocol\src\Deep.Protocol\runtimes\android-arm64\native\libdeep_mlkem_braid.so"
                  Link="deep-native\libdeep_mlkem_braid.so" />
    <AndroidAsset Include="..\..\..\deep-protocol\src\Deep.Protocol\runtimes\android-arm64\native\libdeep_mldsa.so"
                  Link="deep-native\libdeep_mldsa.so" />
    <PackageReference Include="Xamarin.Firebase.Messaging" Version="124.1.2" />
    <GoogleServicesJson Include="$(DeepGoogleServicesJson)" Condition="'$(DeepGoogleServicesJson)' != '' And Exists('$(DeepGoogleServicesJson)')" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release' Or (('$(DeepPhysicalE2E)' != 'true' And '$(DeepLocalDev)' != 'true') Or '$(DeepSurvivalRuntimeEnv)' == '')">
    <EmbeddedResource Include="deep.release.env">
      <LogicalName>deep.release.env</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="ValidatePhysicalUatMailboxInputs" BeforeTargets="PrepareForBuild"
          Condition="'$(DeepPhysicalE2E)' == 'true' And '$(DeepLocalDev)' != 'true' And '$(Configuration)' != 'Release'">
    <Error Condition="'$(PhysicalUatMailboxTrustFloorSupplied)' != 'true'"
           Text="Physical UAT builds require the complete, separately named UAT mailbox trust floor." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeepPhysicalUatMrXPublicKeySha256)', '^[0-9a-f]{64}$')) Or !$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeepPhysicalUatNetworkId)', '^[0-9a-f]{32}$')) Or !$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeepPhysicalUatAuthorityHash)', '^[0-9a-f]{64}$')) Or !$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeepPhysicalUatRevocationHeadHash)', '^[0-9a-f]{64}$')) Or !$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeepPhysicalUatRevocationSnapshotHash)', '^[0-9a-f]{64}$')) Or !$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeepPhysicalUatTopologyHash)', '^[0-9a-f]{64}$'))"
           Text="Physical UAT mailbox trust-floor hashes must be complete lowercase hexadecimal values." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeepPhysicalUatAuthorityGeneration)', '^[1-9][0-9]*$')) Or !$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeepPhysicalUatRevocationGeneration)', '^[1-9][0-9]*$')) Or !$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeepPhysicalUatTopologyGeneration)', '^[1-9][0-9]*$'))"
           Text="Physical UAT mailbox trust-floor generations must be positive decimal integers." />
    <Error Condition="'$(DeepMrXPublicKeySha256)' != '$(DeepPhysicalUatMrXPublicKeySha256)'"
           Text="Physical UAT transport policy and mailbox control plane must use the same build-pinned Mr. X key." />
    <Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(PhysicalUatAndroidBuildIdentitySupplied)' != 'true'"
           Text="Android physical UAT requires its exact package, version and signer lineage." />
    <Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And ('$(DeepPhysicalUatAndroidApplicationId)' != '$(ApplicationId)' Or '$(DeepPhysicalUatAndroidApplicationId)' != 'network.xpoint.deep.e2e')"
           Text="Android physical UAT identity differs from the isolated E2E package." />
    <Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And (!$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeepPhysicalUatAndroidVersionCode)', '^[1-9][0-9]*$')) Or '$(DeepPhysicalUatAndroidVersionCode)' != '$(ApplicationVersion)')"
           Text="Android physical UAT versionCode differs from the E2E package." />
    <Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And !$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeepPhysicalUatAndroidSignerLineageSha256)', '^[0-9a-f]{64}(\|[0-9a-f]{64}){0,31}$'))"
           Text="Android physical UAT signer lineage must contain complete lowercase SHA-256 values." />
    <Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(DeepPhysicalUatAndroidTransparencyPreparation)' != 'true' And ('$(PhysicalUatAndroidTransparencySupplied)' != 'true' Or !Exists('$(DeepPhysicalUatAndroidCodeTransparencyManifest)'))"
           Text="Android physical UAT requires an external UAT Mr. X-signed ACT1 manifest." />
    <Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' And '$(PhysicalUatWindowsBuildIdentitySupplied)' != 'true'"
           Text="Windows physical UAT requires its isolated installed package, publisher and signing certificate hash." />
    <Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' And '$(DeepPhysicalUatWindowsPackageName)' != 'network.xpoint.deep.e2e'"
           Text="Windows physical UAT must use the isolated network.xpoint.deep.e2e MSIX package identity." />
    <Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' And ('$(DeepPhysicalUatWindowsPublisher)' == '' Or !$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeepPhysicalUatWindowsSigningCertificateSha256)', '^[0-9a-f]{64}$')))"
           Text="Windows physical UAT publisher and signing certificate SHA-256 are invalid." />
  </Target>

  <Target Name="ValidatePhysicalUatAndroidTransparencyPreparation" BeforeTargets="PrepareForBuild"
          Condition="'$(DeepPhysicalUatAndroidTransparencyPreparation)' != ''">
    <Error Condition="'$(DeepPhysicalUatAndroidTransparencyPreparation)' != 'true' Or '$(DeepPhysicalE2E)' != 'true' Or '$(Configuration)' == 'Release' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'"
           Text="Physical UAT transparency preparation is accepted only as true for an Android physical non-Release candidate." />
    <Error Condition="'$(PhysicalUatAndroidTransparencySupplied)' == 'true'"
           Text="Physical UAT transparency candidate must not embed an ACT1 asset." />
  </Target>

  <Target Name="RejectPhysicalUatMailboxInputsOutsidePhysicalDebug" BeforeTargets="PrepareForBuild"
          Condition="'$(PhysicalUatMailboxTrustFloorSupplied)$(PhysicalUatAndroidBuildIdentitySupplied)$(PhysicalUatAndroidTransparencySupplied)$(DeepPhysicalUatAndroidTransparencyPreparation)$(PhysicalUatWindowsBuildIdentitySupplied)' != '' And ('$(DeepPhysicalE2E)' != 'true' Or '$(Configuration)' == 'Release')">
    <Error Text="Physical UAT mailbox inputs are forbidden outside a physical non-Release build." />
  </Target>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(DeepSurvivalRuntimeEnv)' != '' And '$(Configuration)' != 'Release' And ('$(DeepPhysicalE2E)' == 'true' Or '$(DeepLocalDev)' == 'true')">
    <EmbeddedResource Include="$(DeepSurvivalRuntimeEnv)">
      <LogicalName>deep.release.env</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(DeepWindowsReleaseEnv)" Condition="'$(DeepWindowsReleaseEnv)' != ''">
      <LogicalName>deep.windows.release.env</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="deep.bootstrap.json">
      <LogicalName>deep.bootstrap.json</LogicalName>
    </EmbeddedResource>
    <MauiAsset Remove="Resources\Raw\geolite2_country_blocks_ipv4" />
    <MauiAsset Remove="Resources\Raw\geolite2_country_codes.json" />
    <MauiAsset Include="Resources\Raw\wwwroot\**" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\Raw\geolite2_country_blocks_ipv4">
      <LogicalName>geolite2_country_blocks_ipv4</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Raw\geolite2_country_codes.json">
      <LogicalName>geolite2_country_codes.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidLibrary Include="Platforms\Android\Jars\libXray.aar" />
    <ProguardConfiguration Include="Platforms\Android\proguard.cfg" />
    <AndroidResource Remove="Platforms\Android\Resources\xml\network_security_config_physical_e2e.xml" />
    <AndroidResource Remove="Platforms\Android\Resources\raw\deep_physical_uat_ca.crt" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(DeepPhysicalE2E)' == 'true' And '$(Configuration)' != 'Release'">
    <AndroidResource Remove="Platforms\Android\Resources\xml\network_security_config.xml" />
    <AndroidResource Include="Platforms\Android\Resources\xml\network_security_config_physical_e2e.xml">
      <Link>Resources\xml\network_security_config.xml</Link>
    </AndroidResource>
    <AndroidResource Include="Platforms\Android\Resources\raw\deep_physical_uat_ca.crt">
      <Link>Resources\raw\deep_physical_uat_ca.crt</Link>
    </AndroidResource>
    <EmbeddedResource Include="Platforms\Android\Resources\raw\deep_physical_uat_ca.crt">
      <LogicalName>Deep.Client.Maui.PhysicalUatRootCa</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifier)' == 'win-x64'">
    <Content Include="Platforms\Windows\Tools\xray-windows-amd64.exe">
      <Link>xray\xray-windows-amd64.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifier)' == 'win-arm64'">
    <Content Include="Platforms\Windows\Tools\xray-windows-arm64.exe">
      <Link>xray\xray-windows-arm64.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(DeepWindowsAppxManifest)' != ''">
    <AppxManifest Include="$(DeepWindowsAppxManifest)" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" BaseSize="512,512" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#020711" BaseSize="160,160" />
    <MauiImage Include="Resources\Images\xpoint_logo.png" Resize="True" BaseSize="256,256" />
    <MauiImage Include="Resources\Images\deep_logo.png" Resize="True" BaseSize="512,512" />
    <MauiImage Include="Resources\Images\deep_mark.png" Resize="True" BaseSize="256,256" />
    <MauiImage Include="Resources\Images\app_icon_*.png" Resize="True" BaseSize="256,256" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <PackageReference Include="Xamarin.AndroidX.Biometric" Version="1.1.0.33" />
  </ItemGroup>

  <Target Name="EnsureGoogleServicesJson" BeforeTargets="PrepareForBuild" Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <Error Condition="'$(DeepGoogleServicesJson)' == '' Or !Exists('$(DeepGoogleServicesJson)')"
           Text="Production Android builds require an external DeepGoogleServicesJson file supplied by the release script." />
  </Target>

  <Target Name="EnsureWindowsRuntimeIdentifier" BeforeTargets="PrepareForBuild" Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifier)' == ''">
    <Error Text="Windows Release builds require -p:RuntimeIdentifierOverride=win-x64 or win-arm64 so the matching pinned Xray binary is packaged." />
  </Target>

  <Target Name="ValidateDeepSurvivalRuntimeEnvironment" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(DeepPhysicalE2E)' == 'true' And '$(Configuration)' != 'Release' And '$(DeepSurvivalRuntimeEnv)' == ''"
           Text="Physical E2E builds require an explicit DeepSurvivalRuntimeEnv file and never fall back to the release runtime environment." />
    <Error Condition="'$(DeepSurvivalRuntimeEnv)' != '' And '$(DeepPhysicalE2E)' != 'true' And '$(DeepLocalDev)' != 'true'"
           Text="DeepSurvivalRuntimeEnv is accepted only with -p:DeepPhysicalE2E=true or -p:DeepLocalDev=true." />
    <Error Condition="'$(DeepSurvivalRuntimeEnv)' != '' And '$(Configuration)' == 'Release'"
           Text="DeepSurvivalRuntimeEnv is forbidden for Release builds." />
    <Error Condition="'$(DeepSurvivalRuntimeEnv)' != '' And '$(Configuration)' != 'Release' And '$(DeepPhysicalE2E)' == 'true' And !Exists('$(DeepSurvivalRuntimeEnv)')"
           Text="DeepSurvivalRuntimeEnv does not identify an existing file." />
  </Target>

  <Target Name="ValidateProductionMailboxTrustFloor" BeforeTargets="PrepareForBuild"
          Condition="'$(ProductionMailboxTrustFloorSupplied)' == 'true'">
    <Error Condition="'$(Configuration)' != 'Release'"
           Text="Production mailbox trust-floor properties are accepted only for Release builds." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeepProductionMrXPublicKeySha256)', '^[0-9a-f]{64}$')) Or !$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeepProductionNetworkId)', '^[0-9a-f]{32}$')) Or !$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeepProductionAuthorityHash)', '^[0-9a-f]{64}$')) Or !$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeepProductionRevocationHeadHash)', '^[0-9a-f]{64}$')) Or !$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeepProductionRevocationSnapshotHash)', '^[0-9a-f]{64}$')) Or !$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeepProductionTopologyHash)', '^[0-9a-f]{64}$'))"
           Text="Production mailbox trust-floor hashes must be complete lowercase hexadecimal values." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeepProductionAuthorityGeneration)', '^[1-9][0-9]*$')) Or !$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeepProductionRevocationGeneration)', '^[1-9][0-9]*$')) Or !$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeepProductionTopologyGeneration)', '^[1-9][0-9]*$'))"
           Text="Production mailbox trust-floor generations must be positive decimal integers." />
  </Target>

  <Target Name="ValidateCiReleaseCandidate" BeforeTargets="PrepareForBuild"
          Condition="'$(DeepCiReleaseCandidate)' != ''">
    <Error Condition="'$(DeepCiReleaseCandidate)' != 'true' Or '$(CI)' != 'true'"
           Text="DeepCiReleaseCandidate is restricted to the CI compilation gate and cannot authorize production packaging." />
  </Target>

  <Target Name="RequireProductionMailboxTrustFloor" BeforeTargets="PrepareForBuild"
          Condition="'$(Configuration)' == 'Release' And '$(DeepCiReleaseCandidate)' != 'true' And ($([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows')">
    <Error Condition="'$(ProductionMailboxTrustFloorSupplied)' != 'true'"
           Text="Release Android and Windows builds require the complete production mailbox trust floor." />
  </Target>

  <Target Name="ValidateProductionAndroidBuildIdentity" BeforeTargets="PrepareForBuild"
          Condition="'$(ProductionAndroidBuildIdentitySupplied)' == 'true'">
    <Error Condition="'$(Configuration)' != 'Release' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'"
           Text="Production Android build identity properties are accepted only for Android Release builds." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeepProductionAndroidSignerLineageSha256)', '^[0-9a-f]{64}(\|[0-9a-f]{64}){0,31}$'))"
           Text="Production Android Play app-signing lineage must contain complete lowercase SHA-256 values." />
    <Error Condition="'$(DeepProductionAndroidApplicationId)' != '$(ApplicationId)' Or '$(DeepProductionAndroidApplicationId)' != 'network.xpoint.deep'"
           Text="Production Android application identity differs from the release package." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeepProductionAndroidVersionCode)', '^[1-9][0-9]*$')) Or '$(DeepProductionAndroidVersionCode)' != '$(ApplicationVersion)'"
           Text="Production Android versionCode differs from the release package." />
  </Target>

  <Target Name="RequireProductionAndroidBuildIdentity" BeforeTargets="PrepareForBuild"
          Condition="'$(Configuration)' == 'Release' And '$(DeepCiReleaseCandidate)' != 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <Error Condition="'$(ProductionAndroidBuildIdentitySupplied)' != 'true'"
           Text="Android Release builds require exact applicationId/versionCode and Play app-signing lineage." />
  </Target>

  <Target Name="RequireProductionAndroidCodeTransparency" BeforeTargets="PrepareForBuild"
          Condition="'$(Configuration)' == 'Release' And '$(DeepCiReleaseCandidate)' != 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(DeepProductionAndroidTransparencyPreparation)' != 'true'">
    <Error Condition="'$(ProductionAndroidTransparencySupplied)' != 'true' Or !Exists('$(DeepProductionAndroidCodeTransparencyManifest)')"
           Text="Android Release builds require an external Mr. X-signed ACT1 code-transparency manifest." />
  </Target>

  <Target Name="ValidateProductionAndroidTransparencyPreparation" BeforeTargets="PrepareForBuild"
          Condition="'$(DeepProductionAndroidTransparencyPreparation)' != ''">
    <Error Condition="'$(DeepProductionAndroidTransparencyPreparation)' != 'true' Or '$(Configuration)' != 'Release' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'"
           Text="Android transparency preparation is accepted only as the exact value true for Android Release candidate builds." />
  </Target>

  <Target Name="GeneratePhysicalLabTrustRoot"
          BeforeTargets="PrepareForBuild"
          Condition="('$(DeepPhysicalE2E)' == 'true' Or '$(DeepLocalDev)' == 'true') And '$(Configuration)' != 'Release'">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeepMrXPublicKeySha256)', '^[0-9a-f]{64}$'))"
           Text="Physical E2E builds require -p:DeepMrXPublicKeySha256=&lt;64 lowercase hex&gt;. The Mr. X trust pin is compiled into the lab binary and cannot come from runtime env." />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(PhysicalLabTrustRootSource)'))" />
    <WriteLinesToFile File="$(PhysicalLabTrustRootSource)"
                      Overwrite="true"
                      Lines="namespace Deep.Client.Maui.Services%3B internal static class PhysicalLabTrustRoot { internal const string MrXPublicKeySha256 = &quot;$(DeepMrXPublicKeySha256)&quot;%3B }" />
  </Target>

  <Target Name="RejectPhysicalLabTrustRootOutsidePhysicalDebug"
          BeforeTargets="PrepareForBuild"
          Condition="'$(DeepMrXPublicKeySha256)' != '' And ('$(Configuration)' == 'Release' Or ('$(DeepPhysicalE2E)' != 'true' And '$(DeepLocalDev)' != 'true'))">
    <Error Text="DeepMrXPublicKeySha256 is forbidden outside a physical non-Release build." />
  </Target>

</Project>
