<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Deep.Client.Maui.Pages.ChatPage"
    AutomationId="Page.Chat"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:domain="clr-namespace:Deep.Client.Shared.Domain;assembly=Deep.Client.Shared"
    xmlns:vm="clr-namespace:Deep.Client.Maui.Core.ViewModels;assembly=Deep.Client.Maui.Core"
    x:DataType="vm:ChatViewModel"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.NavBarIsVisible="False"
    Title="Сообщения">
    <Grid Padding="{StaticResource PagePadding}" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" RowSpacing="10" BackgroundColor="{StaticResource PageBackground}">
        <Border x:Name="NetworkBanner" Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="10,8" IsVisible="False" Stroke="{StaticResource DangerColor}">
            <HorizontalStackLayout Spacing="8">
                <Label Text="Соединение" FontAttributes="Bold" />
                <Label x:Name="NetworkBannerText" Text="Офлайн" TextColor="{StaticResource DangerColor}" />
            </HorizontalStackLayout>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10" Padding="0,4,0,6">
            <Border
                AutomationId="Chat.Back"
                WidthRequest="44"
                HeightRequest="44"
                Padding="0"
                Background="Transparent"
                StrokeThickness="0"
                VerticalOptions="Center">
                <Label Text="‹" FontSize="36" FontAutoScalingEnabled="False" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-3,0,0" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </Border.GestureRecognizers>
            </Border>
            <Border Grid.Column="1" WidthRequest="48" HeightRequest="48" Padding="0" StrokeThickness="0" Background="{StaticResource PrimaryColorMuted}" VerticalOptions="Center" StrokeShape="RoundRectangle 24">
                <Label Text="Q" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" FontSize="20" />
            </Border>
            <Label Grid.Column="2" Text="{Binding Conversation.DisplayName}" FontSize="18" FontAttributes="Bold" LineBreakMode="TailTruncation" VerticalOptions="Center" />
            <Button Grid.Column="3" Text="⋮" SemanticProperties.Description="Информация о чате" Style="{StaticResource ToolbarIconButton}" Clicked="OnInfoClicked" />
        </Grid>

        <Grid Grid.Row="2">
            <Border
                AutomationId="Chat.MessageRequest"
                Padding="12,10"
                Background="{StaticResource PanelBackground}"
                Stroke="{StaticResource PrimaryColor}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                IsVisible="{Binding IsMessageRequest}">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="8">
                    <Label Grid.ColumnSpan="2" Text="Новый контакт. Вы можете принять запрос или заблокировать отправителя." FontSize="13" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" />
                    <Button Grid.Row="1" Text="Заблокировать" Command="{Binding BlockContactCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Grid.Row="1" Grid.Column="1" Text="Принять" Command="{Binding AcceptMessageRequestCommand}" />
                </Grid>
            </Border>
            <Border
                AutomationId="Chat.BlockedContact"
                Padding="12,10"
                Background="{StaticResource PanelBackground}"
                Stroke="{StaticResource DangerColor}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                IsVisible="{Binding IsBlocked}">
                <Label Text="Контакт заблокирован. Новые сообщения от него не сохраняются." FontSize="13" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
            </Border>
        </Grid>

        <CollectionView x:Name="MessagesCollection" AutomationId="Chat.Messages" Grid.Row="3" ItemsSource="{Binding Messages}" Scrolled="OnMessagesScrolled">
            <CollectionView.EmptyView>
                <Grid Padding="0,90,0,0">
                    <Label Text="Пока нет сообщений" FontSize="16" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                </Grid>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatMessageItem">
                    <Grid Padding="0,0,0,6">
                        <Border Background="{StaticResource IncomingBubbleColor}" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="12,8" HorizontalOptions="Start" MaximumWidthRequest="330">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMessageTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="4">
                                <Border Padding="8,5" Background="{StaticResource PanelBackgroundAlt}" StrokeThickness="0" StrokeShape="RoundRectangle 6" IsVisible="{Binding HasReply}">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Ответ" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" />
                                        <Label Text="{Binding ReplyPreview}" FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" MaxLines="2" />
                                    </VerticalStackLayout>
                                </Border>
                                <Label AutomationId="Chat.MessageBody" Text="{Binding Body}" FontSize="15" LineBreakMode="WordWrap" />
                                <Label Text="{Binding ReactionSummary}" FontSize="14" IsVisible="{Binding HasReactions}" TextColor="{StaticResource TextPrimary}" />
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                    <Border Grid.Column="1" Padding="7,2" StrokeThickness="0" Background="{StaticResource PanelBackgroundAlt}" StrokeShape="RoundRectangle 9" IsVisible="{Binding HasAttachments}">
                                        <Label Text="{Binding AttachmentSummary}" FontSize="10" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" MaxLines="1" />
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnAttachmentTapped" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                    <Label Grid.Column="2" Text="{Binding CreatedAt, StringFormat='{}{0:HH:mm}'}" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                    <Label
                                        Grid.Column="3"
                                        Text="{Binding StatusGlyph}"
                                        IsVisible="{Binding IsStatusVisible}"
                                        SemanticProperties.Description="{Binding StatusDescription}"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource TextSecondary}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsReadStatus}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource PrimaryColor}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsFailedStatus}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource DangerColor}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </VerticalStackLayout>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Direction}" Value="{x:Static domain:MessageDirection.Outgoing}">
                                    <Setter Property="Background" Value="{StaticResource OutgoingBubbleColor}" />
                                    <Setter Property="HorizontalOptions" Value="End" />
                                </DataTrigger>
                            </Border.Triggers>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="4" Spacing="6">
            <Border Style="{StaticResource PanelBorder}" Padding="10" IsVisible="{Binding IsReplying}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <BoxView WidthRequest="3" Color="{StaticResource PrimaryColor}" />
                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                        <Label Text="Ответ" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" />
                        <Label Text="{Binding ReplyingToPreview}" FontSize="13" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2" Text="×" SemanticProperties.Description="Отменить ответ" Command="{Binding CancelReplyCommand}" WidthRequest="38" HeightRequest="38" Padding="0" Style="{StaticResource GhostButton}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource PanelBorder}" Padding="10" IsVisible="{Binding HasStagedAttachments}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label AutomationId="Chat.AttachmentSummary" Text="{Binding StagedAttachmentSummary}" LineBreakMode="TailTruncation" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}" />
                    <Button Grid.Column="1" Text="Очистить" Command="{Binding ClearAttachmentsCommand}" WidthRequest="96" Style="{StaticResource SecondaryButton}" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <Label Grid.Row="5" AutomationId="Chat.Error" Text="{Binding ErrorMessage}" TextColor="{StaticResource DangerColor}" FontSize="12" LineBreakMode="WordWrap" />

        <Border Grid.Row="6" Background="{StaticResource PanelBackground}" Stroke="{StaticResource DividerColor}" StrokeThickness="1" Padding="6" StrokeShape="RoundRectangle 24" IsEnabled="{Binding IsComposerEnabled}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Button AutomationId="Chat.Attach" Text="+" SemanticProperties.Description="Добавить вложение" Command="{Binding PickAttachmentsCommand}" WidthRequest="40" HeightRequest="40" Padding="0" FontSize="25" Style="{StaticResource GhostButton}" />
                <Entry x:Name="DraftEntry" AutomationId="Chat.Draft" Grid.Column="1" Placeholder="Сообщение" Text="{Binding Draft}" BackgroundColor="Transparent" ReturnType="Send" ReturnCommand="{Binding SendCommand}" />
                <Button AutomationId="Chat.Send" Grid.Column="2" Text="➤" SemanticProperties.Description="Отправить" Command="{Binding SendCommand}" WidthRequest="40" HeightRequest="40" Padding="0" FontSize="19" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
