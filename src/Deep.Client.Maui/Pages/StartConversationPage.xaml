<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Deep.Client.Maui.Pages.StartConversationPage"
    AutomationId="Page.StartConversation"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#99000000"
    Shell.NavBarIsVisible="False"
    Title="Начать беседу">
    <Grid RowDefinitions="38,*" BackgroundColor="#99000000">
        <BoxView Grid.Row="0" BackgroundColor="Transparent">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseClicked" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border
            Grid.Row="1"
            Background="{StaticResource PanelBackground}"
            StrokeThickness="0"
            Padding="18,12,18,18"
            StrokeShape="RoundRectangle 22,22,0,0">
            <ScrollView>
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="44,*,44" ColumnSpacing="8" HeightRequest="56">
                    <Label
                        Grid.Column="1"
                        Text="Начать беседу"
                        FontSize="24"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center" />

                    <Button
                        Grid.Column="2"
                        AutomationId="StartConversation.Close"
                        Text="×"
                        SemanticProperties.Description="Закрыть"
                        WidthRequest="44"
                        HeightRequest="44"
                        Padding="0"
                        FontSize="28"
                        FontAutoScalingEnabled="False"
                        Style="{StaticResource ToolbarIconButton}"
                        VerticalOptions="Center"
                        Clicked="OnCloseClicked" />
                </Grid>

                <VerticalStackLayout Spacing="0">
                    <Grid AutomationId="StartConversation.NewMessage" ColumnDefinitions="48,*" ColumnSpacing="12" HeightRequest="58">
                        <Path Data="M4,5 H20 V16 H9 L4,21 Z" Stroke="{StaticResource PrimaryColor}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="26" HeightRequest="26" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Новое сообщение" FontSize="17" VerticalTextAlignment="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNewMessageClicked" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" Margin="60,0,0,0" />
                    <Grid AutomationId="StartConversation.CreateGroup" ColumnDefinitions="48,*" ColumnSpacing="12" HeightRequest="58">
                        <Path Data="M8,11 A4,4 0 1 0 8,3 A4,4 0 1 0 8,11 M16,11 A4,4 0 1 0 16,3 A4,4 0 1 0 16,11 M2,21 C2,16 5,13 8,13 C11,13 14,16 14,21 M10,21 C10,16 13,13 16,13 C19,13 22,16 22,21" Stroke="{StaticResource PrimaryColor}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="28" HeightRequest="28" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Создать группу" FontSize="17" VerticalTextAlignment="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCreateGroupClicked" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" Margin="60,0,0,0" />
                    <Grid AutomationId="StartConversation.InviteFriend" ColumnDefinitions="48,*" ColumnSpacing="12" HeightRequest="58">
                        <Path Data="M9,11 A4,4 0 1 0 9,3 A4,4 0 1 0 9,11 M2,21 C2,16 5,13 9,13 C13,13 16,16 16,21 M19,9 V17 M15,13 H23" Stroke="{StaticResource PrimaryColor}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="28" HeightRequest="28" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Пригласить друга" FontSize="17" VerticalTextAlignment="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnInviteFriendClicked" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8" Padding="0,6,0,0">
                    <Label Text="ID вашего аккаунта" FontSize="17" />
                    <Label Text="Покажите этот QR-код человеку, который хочет начать с вами беседу." FontSize="13" TextColor="{StaticResource TextSecondary}" />
                    <Label
                        x:Name="AccountIdLabel"
                        AutomationId="StartConversation.AccountId"
                        IsVisible="False" />

                    <Border
                        Background="White"
                        StrokeThickness="0"
                        Padding="12"
                        HorizontalOptions="Center"
                        StrokeShape="RoundRectangle 6">
                        <Image
                            x:Name="AccountQrImage"
                            AutomationId="StartConversation.AccountQr"
                            WidthRequest="250"
                            HeightRequest="250"
                            Aspect="AspectFit" />
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Padding="0,4,0,0">
                        <Border AutomationId="StartConversation.Share" Stroke="{StaticResource PrimaryColor}" StrokeThickness="1" Background="Transparent" Padding="0,10" StrokeShape="RoundRectangle 21">
                            <Label Text="Поделиться" TextColor="{StaticResource PrimaryColor}" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnShareClicked" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border Grid.Column="1" AutomationId="StartConversation.Copy" Stroke="{StaticResource PrimaryColor}" StrokeThickness="1" Background="Transparent" Padding="0,10" StrokeShape="RoundRectangle 21">
                            <Label Text="Скопировать" TextColor="{StaticResource PrimaryColor}" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCopyClicked" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
