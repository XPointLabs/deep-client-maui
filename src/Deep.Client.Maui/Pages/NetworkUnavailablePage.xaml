<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Deep.Client.Maui.Pages.NetworkUnavailablePage"
    AutomationId="Page.NetworkUnavailable"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.NavBarIsVisible="False"
    Title="Аккаунт готов">
    <Grid Padding="{StaticResource PagePadding}">
        <VerticalStackLayout
            Spacing="14"
            MaximumWidthRequest="560"
            HorizontalOptions="Center"
            VerticalOptions="Center">
            <Image Source="deep_mark.png" WidthRequest="96" HeightRequest="96" Aspect="AspectFit" />
            <Label
                x:Name="StatusTitle"
                AutomationId="NetworkUnavailable.Title"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center" />
            <Label
                x:Name="StatusMessage"
                AutomationId="NetworkUnavailable.Message"
                FontSize="15"
                TextColor="{StaticResource TextSecondary}"
                HorizontalTextAlignment="Center" />
            <Button
                AutomationId="AccountHome.AddContact"
                Text="Добавить контакт"
                Clicked="OnAddContactClicked" />
            <Button
                AutomationId="AccountHome.MyDeepId"
                Text="Мой Deep ID"
                Clicked="OnMyDeepIdClicked" />
            <Button
                AutomationId="AccountHome.Settings"
                Text="Настройки и сид-фраза"
                Clicked="OnSettingsClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
