<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Deep.Client.Maui.Pages.SettingsPage"
    AutomationId="Page.Settings"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Deep.Client.Maui.Core.ViewModels;assembly=Deep.Client.Maui.Core"
    x:DataType="vm:SettingsViewModel"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.NavBarIsVisible="False"
    Title="Настройки">
    <Grid RowDefinitions="Auto,*" BackgroundColor="{StaticResource PageBackground}">
        <Grid
            Grid.Row="0"
            Style="{StaticResource CompactHeader}"
            ColumnDefinitions="48,*,48,48"
            BackgroundColor="{StaticResource PageBackground}">
            <Label
                Grid.ColumnSpan="4"
                Text="Настройки"
                FontSize="20"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center"
                HorizontalOptions="Fill"
                VerticalOptions="Center" />

            <Border
                Grid.Column="0"
                AutomationId="Settings.Back"
                WidthRequest="40"
                HeightRequest="40"
                Padding="0"
                Background="Transparent"
                StrokeThickness="0"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{StaticResource TextPrimary}" StrokeThickness="2.2" Fill="Transparent" WidthRequest="22" HeightRequest="22" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </Border.GestureRecognizers>
            </Border>

            <Border
                Grid.Column="2"
                AutomationId="Settings.EditName"
                WidthRequest="40"
                HeightRequest="40"
                Background="Transparent"
                StrokeThickness="0"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Path Data="M5,19 L9,18 L19,8 L16,5 L6,15 Z M14,7 L17,10" Stroke="{StaticResource PrimaryColor}" StrokeThickness="2" Fill="Transparent" WidthRequest="22" HeightRequest="22" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnEditNameClicked" />
                </Border.GestureRecognizers>
            </Border>

            <Border
                Grid.Column="3"
                AutomationId="Settings.Qr"
                WidthRequest="40"
                HeightRequest="40"
                Background="Transparent"
                StrokeThickness="0"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Grid WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center">
                    <Path Data="M2,2 H9 V9 H2 Z M15,2 H22 V9 H15 Z M2,15 H9 V22 H2 Z M15,15 H18 V18 H15 Z M19,19 H22 V22 H19 Z" Stroke="{StaticResource PrimaryColor}" StrokeThickness="1.8" Fill="Transparent" Aspect="Uniform" />
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnQrClicked" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <ScrollView Grid.Row="1" BackgroundColor="{StaticResource PageBackground}">
            <VerticalStackLayout Padding="16,10,16,20" Spacing="14">
                <Grid HorizontalOptions="Center" WidthRequest="104" HeightRequest="94">
                    <Border
                        AutomationId="Settings.Avatar"
                        WidthRequest="88"
                        HeightRequest="88"
                        Padding="0"
                        StrokeThickness="0"
                        Background="{StaticResource AvatarAccentColor}"
                        HorizontalOptions="Center"
                        VerticalOptions="Start"
                        StrokeShape="RoundRectangle 44">
                        <Grid>
                            <Image x:Name="ProfileAvatarImage" Aspect="AspectFill" IsVisible="False" />
                            <Label x:Name="ProfileInitialLabel" Text="{Binding AccountInitial}" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" FontSize="34" FontAutoScalingEnabled="False" />
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChangePhotoClicked" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border
                        WidthRequest="36"
                        HeightRequest="36"
                        Padding="0"
                        StrokeThickness="0"
                        Background="{StaticResource PrimaryColor}"
                        StrokeShape="RoundRectangle 18"
                        HorizontalOptions="End"
                        VerticalOptions="End">
                        <Path Data="M12,5 V19 M5,12 H19" Stroke="#020711" StrokeThickness="2.4" StrokeLineCap="Round" Fill="Transparent" WidthRequest="22" HeightRequest="22" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChangePhotoClicked" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <Label
                    AutomationId="Settings.DisplayName"
                    Text="{Binding AccountDisplayName}"
                    FontSize="23"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    HorizontalOptions="Fill"
                    LineBreakMode="TailTruncation">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEditNameClicked" />
                    </Label.GestureRecognizers>
                </Label>

                <Border Style="{StaticResource SettingsSection}" Padding="14,11">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="ID аккаунта Deep" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <Label x:Name="SessionIdLabel" AutomationId="Settings.SessionId" Text="{Binding SessionId}" FontSize="13" FontFamily="Consolas" LineBreakMode="NoWrap" MaxLines="1" WidthRequest="620" HorizontalOptions="Start" />
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Padding="0,2,0,0">
                    <Border AutomationId="Settings.Share" Stroke="{StaticResource PrimaryColor}" StrokeThickness="1" Background="Transparent" HeightRequest="42" Padding="0" StrokeShape="RoundRectangle 21">
                        <Label Text="Поделиться" TextColor="{StaticResource PrimaryColor}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnShareClicked" />
                        </Border.GestureRecognizers>
                    </Border>
                    <Border Grid.Column="1" AutomationId="Settings.Copy" Stroke="{StaticResource PrimaryColor}" StrokeThickness="1" Background="Transparent" HeightRequest="42" Padding="0" StrokeShape="RoundRectangle 21">
                        <Label Text="Скопировать" TextColor="{StaticResource PrimaryColor}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCopySessionIdClicked" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <Border Background="{StaticResource PanelBackground}" StrokeThickness="0" Padding="0" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="0">
                        <Grid AutomationId="Settings.Invite" ColumnDefinitions="52,*,Auto" ColumnSpacing="0" HeightRequest="52" Padding="8,0">
                            <Path Data="M12,5 V19 M5,12 H19" Stroke="{StaticResource PrimaryColor}" StrokeThickness="2.2" StrokeLineCap="Round" Fill="Transparent" WidthRequest="24" HeightRequest="24" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Пригласить друга" FontSize="16" VerticalTextAlignment="Center" />
                            <Path Grid.Column="2" Data="M9,5 L16,12 L9,19" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnInviteClicked" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Background="{StaticResource PanelBackground}" StrokeThickness="0" Padding="0" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="0">
                        <Grid AutomationId="Settings.Donate" ColumnDefinitions="52,*,Auto" ColumnSpacing="0" HeightRequest="52" Padding="8,0">
                            <Path Data="M12,21 C8,18 4,14.7 4,10 A4,4 0 0 1 11,7 A4,4 0 0 1 18,10 C18,14.7 16,17.5 12,21 Z" Stroke="{StaticResource PrimaryColor}" StrokeThickness="2" Fill="Transparent" WidthRequest="24" HeightRequest="24" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Поддержать сеть" FontSize="16" VerticalTextAlignment="Center" />
                            <Path Grid.Column="2" Data="M9,5 L16,12 L9,19" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDonateClicked" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" Margin="60,0,12,0" />
                        <Grid AutomationId="Settings.Path" ColumnDefinitions="52,*,Auto" ColumnSpacing="0" HeightRequest="52" Padding="8,0">
                            <Path Data="M5,18 C8,14 10,12 12,12 C14,12 16,10 19,6 M6,6 H19 V19" Stroke="{StaticResource PrimaryColor}" StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" WidthRequest="24" HeightRequest="24" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="Путь" FontSize="16" />
                                <Label Text="{Binding ConnectionStatus}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Path Grid.Column="2" Data="M9,5 L16,12 L9,19" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPathClicked" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" Margin="60,0,12,0" />
                        <Grid AutomationId="Settings.SessionNetwork" ColumnDefinitions="52,*,Auto" ColumnSpacing="0" HeightRequest="52" Padding="8,0">
                            <Image Source="xpoint_logo.png" WidthRequest="28" HeightRequest="28" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" SemanticProperties.Description="XPoint Network" />
                            <Label Grid.Column="1" Text="Сеть XPoint" FontSize="16" VerticalTextAlignment="Center" />
                            <Path Grid.Column="2" Data="M9,5 L16,12 L9,19" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSessionNetworkClicked" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" Margin="60,0,12,0" />
                        <Grid AutomationId="Settings.OfflineUpdate" ColumnDefinitions="52,*,Auto" ColumnSpacing="0" HeightRequest="52" Padding="8,0">
                            <Path Data="M12,3 V15 M7,10 L12,15 L17,10 M5,20 H19" Stroke="{StaticResource PrimaryColor}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" WidthRequest="28" HeightRequest="28" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="Офлайн-обновление" FontSize="16" />
                                <Label Text="Проверка подписанного APK" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Path Grid.Column="2" Data="M9,5 L16,12 L9,19" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOfflineUpdateClicked" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Background="{StaticResource PanelBackground}" StrokeThickness="0" Padding="0" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="0">
                        <Grid AutomationId="Settings.Privacy" ColumnDefinitions="52,*,Auto" ColumnSpacing="0" HeightRequest="52" Padding="8,0">
                            <Path Data="M12,2 L4,5 V11 C4,16 7.5,20 12,22 C16.5,20 20,16 20,11 V5 Z" Stroke="{StaticResource PrimaryColor}" StrokeThickness="2.4" Fill="Transparent" WidthRequest="28" HeightRequest="28" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Конфиденциальность" FontSize="16" VerticalTextAlignment="Center" />
                            <Path Grid.Column="2" Data="M9,5 L16,12 L9,19" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPrivacyClicked" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" Margin="60,0,12,0" />
                        <Grid AutomationId="Settings.Notifications" ColumnDefinitions="52,*,Auto" ColumnSpacing="0" HeightRequest="52" Padding="8,0">
                            <Path Data="M18,8 A6,6 0 0 0 6,8 C6,15 3,17 3,17 H21 C21,17 18,15 18,8 M10,21 H14" Stroke="{StaticResource PrimaryColor}" StrokeThickness="2.4" Fill="Transparent" WidthRequest="28" HeightRequest="28" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Уведомления" FontSize="16" VerticalTextAlignment="Center" />
                            <Path Grid.Column="2" Data="M9,5 L16,12 L9,19" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNotificationsClicked" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" Margin="60,0,12,0" />
                        <Grid AutomationId="Settings.Conversations" ColumnDefinitions="52,*,Auto" ColumnSpacing="0" HeightRequest="52" Padding="8,0">
                            <Path Data="M4,5 H20 V15 H10 L5,20 V15 H4 Z" Stroke="{StaticResource PrimaryColor}" StrokeThickness="2.4" Fill="Transparent" WidthRequest="28" HeightRequest="28" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Диалоги" FontSize="16" VerticalTextAlignment="Center" />
                            <Path Grid.Column="2" Data="M9,5 L16,12 L9,19" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnConversationsSettingsClicked" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" Margin="60,0,12,0" />
                        <Grid AutomationId="Settings.Appearance" ColumnDefinitions="52,*,Auto" ColumnSpacing="0" HeightRequest="52" Padding="8,0">
                            <Path Data="M12,3 A9,9 0 1 0 12,21 A4.5,4.5 0 1 1 12,3 Z" Stroke="{StaticResource PrimaryColor}" StrokeThickness="2.4" Fill="Transparent" WidthRequest="28" HeightRequest="28" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Оформление" FontSize="16" VerticalTextAlignment="Center" />
                            <Path Grid.Column="2" Data="M9,5 L16,12 L9,19" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAppearanceClicked" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" Margin="60,0,12,0" />
                        <Grid AutomationId="Settings.MessageRequests" ColumnDefinitions="52,*,Auto" ColumnSpacing="0" HeightRequest="52" Padding="8,0">
                            <Path Data="M4,5 H20 V15 H11 L7,19 V15 H4 Z M9,10 H15" Stroke="{StaticResource PrimaryColor}" StrokeThickness="2.4" Fill="Transparent" WidthRequest="28" HeightRequest="28" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Запросы сообщений" FontSize="16" VerticalTextAlignment="Center" />
                            <Path Grid.Column="2" Data="M9,5 L16,12 L9,19" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMessageRequestsClicked" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Background="{StaticResource PanelBackground}" StrokeThickness="0" Padding="0" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="0">
                        <Grid AutomationId="Settings.RecoveryPhrase" ColumnDefinitions="52,*,Auto" ColumnSpacing="0" HeightRequest="52" Padding="8,0">
                            <Path Data="M7,14 A4,4 0 1 1 11,10 H21 V13 H18 V16 H15" Stroke="{StaticResource PrimaryColor}" StrokeThickness="2.4" Fill="Transparent" WidthRequest="28" HeightRequest="28" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Фраза восстановления" FontSize="16" VerticalTextAlignment="Center" />
                            <Path Grid.Column="2" Data="M9,5 L16,12 L9,19" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRecoveryPhraseClicked" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" Margin="60,0,12,0" />
                        <Grid AutomationId="Settings.Help" ColumnDefinitions="52,*,Auto" ColumnSpacing="0" HeightRequest="52" Padding="8,0">
                            <Path Data="M12,4 A7,7 0 1 0 12,18 A7,7 0 1 0 12,4 M12,19 V21 M12,8 V13" Stroke="{StaticResource PrimaryColor}" StrokeThickness="2.4" Fill="Transparent" WidthRequest="28" HeightRequest="28" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Помощь" FontSize="16" VerticalTextAlignment="Center" />
                            <Path Grid.Column="2" Data="M9,5 L16,12 L9,19" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnHelpClicked" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" Margin="60,0,12,0" />
                        <Grid AutomationId="Settings.Logout" ColumnDefinitions="52,*,Auto" ColumnSpacing="0" HeightRequest="52" Padding="8,0">
                            <Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{StaticResource DangerColor}" StrokeThickness="2.6" Fill="Transparent" WidthRequest="26" HeightRequest="26" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Очистить данные" FontSize="16" TextColor="{StaticResource DangerColor}" VerticalTextAlignment="Center" />
                            <Path Grid.Column="2" Data="M9,5 L16,12 L9,19" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLogoutClicked" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource DangerColor}" FontSize="13" HorizontalTextAlignment="Center" />
                <Label x:Name="VersionLabel" TextColor="{StaticResource TextSecondary}" FontSize="12" HorizontalTextAlignment="Center" Margin="0,0,0,8" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
