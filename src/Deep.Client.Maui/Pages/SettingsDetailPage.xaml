<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Deep.Client.Maui.Pages.SettingsDetailPage"
    AutomationId="Page.SettingsDetail"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.NavBarIsVisible="False"
    Title="Настройки">
    <ScrollView BackgroundColor="{StaticResource PageBackground}">
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="14">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,12,0,8">
                <Border
                    AutomationId="SettingsDetail.Back"
                    WidthRequest="44"
                    HeightRequest="44"
                    Padding="0"
                    Background="Transparent"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                    <Label Text="&lt;" FontSize="24" FontAttributes="Bold" FontAutoScalingEnabled="False" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackClicked" />
                    </Border.GestureRecognizers>
                </Border>

                <Label
                    x:Name="TitleLabel"
                    Grid.Column="1"
                    Text="Настройки"
                    FontSize="24"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Start"
                    VerticalOptions="Center" />
            </Grid>

            <VerticalStackLayout x:Name="ContentStack" Spacing="12" />

            <Label
                x:Name="StatusLabel"
                AutomationId="SettingsDetail.Status"
                TextColor="{StaticResource TextSecondary}"
                FontSize="13"
                LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
