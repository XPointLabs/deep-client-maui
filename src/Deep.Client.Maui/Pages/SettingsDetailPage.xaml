<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Deep.Client.Maui.Pages.SettingsDetailPage"
    AutomationId="Page.SettingsDetail"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.NavBarIsVisible="False"
    Title="Настройки">
    <Grid RowDefinitions="Auto,*" BackgroundColor="{StaticResource PageBackground}">
            <Grid Grid.Row="0" Style="{StaticResource CompactHeader}" ColumnDefinitions="40,*" ColumnSpacing="8">
                <Border
                    AutomationId="SettingsDetail.Back"
                    WidthRequest="40"
                    HeightRequest="40"
                    Padding="0"
                    Background="Transparent"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                    <Path Data="M15,4 L7,12 L15,20" Stroke="{StaticResource PrimaryColor}" StrokeThickness="2.4" Fill="Transparent" WidthRequest="22" HeightRequest="22" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackClicked" />
                    </Border.GestureRecognizers>
                </Border>

                <Label
                    x:Name="TitleLabel"
                    Grid.Column="1"
                    Text="Настройки"
                    FontSize="20"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Start"
                    VerticalOptions="Center" />
            </Grid>
        <ScrollView Grid.Row="1" BackgroundColor="{StaticResource PageBackground}">
            <VerticalStackLayout Padding="16,12,16,20" Spacing="14">
                <VerticalStackLayout x:Name="ContentStack" Spacing="12" />
                <Label x:Name="StatusLabel" AutomationId="SettingsDetail.Status" TextColor="{StaticResource TextSecondary}" FontSize="13" LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
