<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Deep.Client.Maui.Pages.GroupChatPage"
    AutomationId="Page.GroupChat"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:domain="clr-namespace:Deep.Client.Shared.Domain;assembly=Deep.Client.Shared"
    xmlns:vm="clr-namespace:Deep.Client.Maui.Core.ViewModels;assembly=Deep.Client.Maui.Core"
    x:DataType="vm:GroupChatViewModel"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.NavBarIsVisible="False"
    Title="Групповой чат">
    <Grid x:Name="PageLayout" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="0" BackgroundColor="{StaticResource PageBackground}">
        <VerticalStackLayout Grid.Row="0" Spacing="0">
            <Border x:Name="NetworkBanner" Padding="12,6" IsVisible="False" Background="{StaticResource PanelBackground}" StrokeThickness="0">
                <HorizontalStackLayout Spacing="7" HorizontalOptions="Center">
                    <Border WidthRequest="7" HeightRequest="7" StrokeThickness="0" Background="{StaticResource DangerColor}" StrokeShape="RoundRectangle 4" VerticalOptions="Center" />
                    <Label x:Name="NetworkBannerText" Text="Нет соединения" FontSize="12" TextColor="{StaticResource DangerColor}" />
                </HorizontalStackLayout>
            </Border>
            <Grid Style="{StaticResource CompactHeader}" ColumnDefinitions="40,42,*,40" ColumnSpacing="4">
                <Border AutomationId="GroupChat.Back" WidthRequest="40" HeightRequest="40" Padding="0" Background="Transparent" StrokeThickness="0" VerticalOptions="Center">
                    <Path Data="M15,4 L7,12 L15,20" Stroke="{StaticResource PrimaryColor}" StrokeThickness="2.4" Fill="Transparent" WidthRequest="22" HeightRequest="22" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBackClicked" /></Border.GestureRecognizers>
                </Border>
                <Border Grid.Column="1" WidthRequest="40" HeightRequest="40" Padding="0" StrokeThickness="0" Background="{StaticResource PrimaryColorMuted}" VerticalOptions="Center" StrokeShape="RoundRectangle 20">
                    <Label Text="G" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" FontSize="16" />
                </Border>
                <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center" Margin="5,0,0,0">
                    <Label Text="{Binding GroupTitle}" FontSize="16" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding GroupSubtitle}" FontSize="11" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
                <Button Grid.Column="3" AutomationId="GroupChat.Members" Text="⋮" SemanticProperties.Description="Участники группы" Style="{StaticResource CircularIconButton}" Clicked="OnMembersClicked" />
            </Grid>
            <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Border x:Name="MembersPanel" Grid.Row="0" Background="{StaticResource PanelBackground}" Stroke="{StaticResource DividerColor}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="10" Margin="10,8,10,2" IsVisible="False">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                    <Label Text="{Binding StatusMessage}" FontSize="12" TextColor="{StaticResource PrimaryColor}" LineBreakMode="TailTruncation">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsStatusError}" Value="True"><Setter Property="TextColor" Value="{StaticResource DangerColor}" /></DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Border Background="{StaticResource SearchBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,0">
                            <Entry AutomationId="GroupChat.MemberSessionId" Placeholder="ID участника" Text="{Binding MemberSessionId}" HeightRequest="42" BackgroundColor="Transparent" />
                        </Border>
                        <Button Grid.Column="1" Text="Добавить" Command="{Binding AddMemberCommand}" WidthRequest="108" />
                    </Grid>
                    <CollectionView Grid.Row="2" ItemsSource="{Binding Members}" ItemSizingStrategy="MeasureFirstItem" HeightRequest="86" SelectionMode="Single" SelectedItem="{Binding SelectedMember, Mode=TwoWay}" SelectionChanged="OnMemberSelectionChanged">
                        <CollectionView.EmptyView><Label Text="Нет участников" FontSize="12" TextColor="{StaticResource TextSecondary}" /></CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:GroupMemberItem">
                                <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,0,0,4" ColumnSpacing="6">
                                    <Label Text="{Binding SessionId.Value}" FontSize="11" LineBreakMode="TailTruncation" />
                                    <Border Grid.Column="1" StrokeThickness="0" Padding="6,2" Background="{StaticResource PanelBackgroundAlt}" StrokeShape="RoundRectangle 8"><Label Text="{Binding Role}" FontSize="10" TextColor="{StaticResource TextSecondary}" /></Border>
                                    <Border Grid.Column="2" StrokeThickness="0" Padding="6,2" Background="{StaticResource DangerColor}" StrokeShape="RoundRectangle 8" IsVisible="{Binding IsPendingRemoval}"><Label Text="Ожидает" FontSize="10" TextColor="#050705" /></Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>

            <CollectionView x:Name="MessagesCollection" AutomationId="GroupChat.Messages" Grid.Row="1" Margin="8,4" Opacity="0" ItemsSource="{Binding Messages}" ItemsUpdatingScrollMode="KeepLastItemInView" Scrolled="OnMessagesScrolled">
            <CollectionView.EmptyView>
                <Grid Padding="0,70,0,0">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                        <Image Source="deep_mark.png" WidthRequest="42" HeightRequest="42" Opacity="0.8" />
                        <Label Text="Пока нет сообщений" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="Начните защищенную групповую переписку" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:GroupChatMessageItem">
                    <Grid Padding="2,0,2,4">
                        <Border Background="{StaticResource IncomingBubbleColor}" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="11,7" HorizontalOptions="Start" MaximumWidthRequest="318">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMessageTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding SenderLabel}" IsVisible="{Binding ShowSenderLabel}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" LineBreakMode="TailTruncation" />
                                <Border Padding="8,5" Background="{StaticResource PanelBackgroundAlt}" StrokeThickness="0" StrokeShape="RoundRectangle 6" IsVisible="{Binding HasReply}">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Ответ" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" />
                                        <Label Text="{Binding ReplyPreview}" FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" MaxLines="2" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Style="{StaticResource AttachmentCard}" IsVisible="{Binding IsVoiceMessage}">
                                    <Grid ColumnDefinitions="38,*,Auto" ColumnSpacing="9">
                                        <Border WidthRequest="36" HeightRequest="36" Background="{StaticResource PrimaryColor}" StrokeThickness="0" StrokeShape="RoundRectangle 18" VerticalOptions="Center">
                                            <Path Data="M10,7 L23,18 L10,29 Z" Fill="#020711" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="3" HeightRequest="20" VerticalOptions="Center">
                                                <BoxView WidthRequest="3" HeightRequest="8" Color="{StaticResource PrimaryColor}" VerticalOptions="Center" />
                                                <BoxView WidthRequest="3" HeightRequest="14" Color="{StaticResource PrimaryColor}" VerticalOptions="Center" />
                                                <BoxView WidthRequest="3" HeightRequest="10" Color="{StaticResource PrimaryColor}" VerticalOptions="Center" />
                                                <BoxView WidthRequest="3" HeightRequest="18" Color="{StaticResource PrimaryColor}" VerticalOptions="Center" />
                                                <BoxView WidthRequest="3" HeightRequest="12" Color="{StaticResource PrimaryColor}" VerticalOptions="Center" />
                                                <BoxView WidthRequest="3" HeightRequest="16" Color="{StaticResource PrimaryColor}" VerticalOptions="Center" />
                                                <BoxView WidthRequest="3" HeightRequest="7" Color="{StaticResource PrimaryColor}" VerticalOptions="Center" />
                                                <BoxView WidthRequest="3" HeightRequest="13" Color="{StaticResource PrimaryColor}" VerticalOptions="Center" />
                                                <BoxView WidthRequest="3" HeightRequest="9" Color="{StaticResource PrimaryColor}" VerticalOptions="Center" />
                                                <BoxView WidthRequest="3" HeightRequest="17" Color="{StaticResource PrimaryColor}" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding VoiceDurationLabel}" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                        </VerticalStackLayout>
                                        <Path Grid.Column="2" Data="M12,4 C10.3,4 9,5.3 9,7 V12 C9,13.7 10.3,15 12,15 C13.7,15 15,13.7 15,12 V7 C15,5.3 13.7,4 12,4 Z M7,11 C7,13.8 9.2,16 12,16 C14.8,16 17,13.8 17,11 M12,16 V20" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.6" Fill="Transparent" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="End" />
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnVoiceMessageTapped" />
                                    </Border.GestureRecognizers>
                                </Border>
                                <Border Style="{StaticResource AttachmentCard}" IsVisible="{Binding HasNonVoiceAttachments}">
                                    <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="9">
                                        <Border WidthRequest="38" HeightRequest="38" Background="{StaticResource PrimaryColorMuted}" StrokeThickness="0" StrokeShape="RoundRectangle 19" VerticalOptions="Center">
                                            <Path Data="M8,5 H19 L24,10 V27 H8 Z M19,5 V10 H24 M11,18 H21 M11,22 H18" Stroke="White" StrokeThickness="1.8" Fill="Transparent" WidthRequest="24" HeightRequest="24" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="{Binding AttachmentTitle}" FontSize="13" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding AttachmentSubtitle}" FontSize="11" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <Path Grid.Column="2" Data="M9,5 L16,12 L9,19" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" />
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAttachmentTapped" />
                                    </Border.GestureRecognizers>
                                </Border>
                                <Label Text="{Binding Body}" IsVisible="{Binding HasVisibleBody}" FontSize="15" LineBreakMode="WordWrap" />
                                <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center" IsVisible="{Binding HasReactions}" BindableLayout.ItemsSource="{Binding ReactionChips}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MessageReactionChip">
                                            <Border Style="{StaticResource ReactionChip}" Margin="0,0,4,2">
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="{Binding Emoji}" FontSize="14" />
                                                    <Label Text="{Binding Count}" FontSize="11" TextColor="{StaticResource TextSecondary}" VerticalTextAlignment="Center" />
                                                </HorizontalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                    <Label Grid.Column="2" Text="{Binding CreatedAt, StringFormat='{}{0:HH:mm}'}" FontSize="10" TextColor="{StaticResource TextTertiary}" />
                                    <Label
                                        Grid.Column="3"
                                        Text="{Binding StatusGlyph}"
                                        IsVisible="{Binding IsStatusVisible}"
                                        SemanticProperties.Description="{Binding StatusDescription}"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource TextTertiary}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsReadStatus}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource PrimaryColor}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsFailedStatus}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource DangerColor}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </VerticalStackLayout>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Direction}" Value="{x:Static domain:MessageDirection.Outgoing}">
                                    <Setter Property="Background" Value="{StaticResource OutgoingBubbleColor}" />
                                    <Setter Property="HorizontalOptions" Value="End" />
                                </DataTrigger>
                            </Border.Triggers>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="5" Padding="8,4,8,0" BackgroundColor="{StaticResource PageBackground}">
            <Border Grid.Row="0" Background="{StaticResource PanelBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,7" IsVisible="{Binding IsReplying}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <BoxView WidthRequest="3" Color="{StaticResource PrimaryColor}" />
                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                        <Label Text="Ответ" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" />
                        <Label Text="{Binding ReplyingToPreview}" FontSize="13" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2" Text="×" SemanticProperties.Description="Отменить ответ" Command="{Binding CancelReplyCommand}" WidthRequest="38" HeightRequest="38" Padding="0" Style="{StaticResource GhostButton}" />
                </Grid>
            </Border>
            <Border Grid.Row="1" Background="{StaticResource PanelBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,7" IsVisible="{Binding HasStagedAttachments}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding StagedAttachments}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="domain:AttachmentMetadata">
                                <Border Background="{StaticResource PanelBackgroundAlt}" Stroke="{StaticResource DividerColor}" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="9,5">
                                    <HorizontalStackLayout Spacing="6">
                                        <Path Data="M8,5 H18 L23,10 V25 H8 Z M18,5 V10 H23" Stroke="{StaticResource PrimaryColor}" StrokeThickness="1.7" Fill="Transparent" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" />
                                        <Label Text="{Binding FileName}" FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" MaxLines="1" WidthRequest="150" />
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                    <Button Grid.Column="1" Text="Очистить" Command="{Binding ClearAttachmentsCommand}" WidthRequest="96" Style="{StaticResource SecondaryButton}" />
                </Grid>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource VoiceRecordingPanel}" IsVisible="{Binding IsRecordingVoice}">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="9">
                    <Border WidthRequest="10" HeightRequest="10" Background="{StaticResource DangerColor}" StrokeThickness="0" StrokeShape="RoundRectangle 5" VerticalOptions="Center" />
                    <Label x:Name="VoiceElapsedLabel" Grid.Column="1" Text="00:00" FontSize="14" TextColor="{StaticResource TextPrimary}" VerticalTextAlignment="Center" />
                    <HorizontalStackLayout Grid.Column="2" Spacing="3" HeightRequest="24" VerticalOptions="Center">
                        <BoxView Style="{StaticResource VoiceWaveBar}" HeightRequest="8" />
                        <BoxView Style="{StaticResource VoiceWaveBar}" HeightRequest="15" />
                        <BoxView Style="{StaticResource VoiceWaveBar}" HeightRequest="11" />
                        <BoxView Style="{StaticResource VoiceWaveBar}" HeightRequest="20" />
                        <BoxView Style="{StaticResource VoiceWaveBar}" HeightRequest="13" />
                        <BoxView Style="{StaticResource VoiceWaveBar}" HeightRequest="17" />
                        <BoxView Style="{StaticResource VoiceWaveBar}" HeightRequest="9" />
                        <Label Text="Запись" FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalTextAlignment="Center" Margin="5,0,0,0" />
                    </HorizontalStackLayout>
                    <Button Grid.Column="3" Text="Отмена" Clicked="OnCancelVoiceClicked" WidthRequest="86" HeightRequest="34" Style="{StaticResource GhostButton}" TextColor="{StaticResource DangerColor}" />
                </Grid>
            </Border>
            <Label Grid.Row="3" AutomationId="GroupChat.Error" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource DangerColor}" FontSize="12" LineBreakMode="WordWrap" Margin="8,0" />
        </Grid>
        <Grid Grid.Row="3" HeightRequest="56" MinimumHeightRequest="56" Padding="8,4,8,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7" BackgroundColor="{StaticResource PageBackground}">
            <Border AutomationId="GroupChat.Attach" Style="{StaticResource ComposerIconSurface}" SemanticProperties.Description="Добавить вложение">
                <Path Data="M12,4 L6.5,9.5 C4.3,11.7 4.3,15.3 6.5,17.5 C8.7,19.7 12.3,19.7 14.5,17.5 L21,11 C22.4,9.6 22.4,7.4 21,6 C19.6,4.6 17.4,4.6 16,6 L8.8,13.2 C8.1,13.9 8.1,15.1 8.8,15.8 C9.5,16.5 10.7,16.5 11.4,15.8 L17,10.2" Stroke="{StaticResource PrimaryColor}" StrokeThickness="2" Fill="Transparent" WidthRequest="24" HeightRequest="24" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAttachClicked" /></Border.GestureRecognizers>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource SearchBackground}" Stroke="{StaticResource DividerColor}" StrokeThickness="1" StrokeShape="RoundRectangle 21" Padding="10,0">
                <Entry x:Name="DraftEntry" AutomationId="GroupChat.Draft" Placeholder="Сообщение" Text="{Binding Draft}" HeightRequest="42" BackgroundColor="Transparent" ReturnType="Send" ReturnCommand="{Binding SendCommand}" />
            </Border>
            <Border AutomationId="GroupChat.Send" Grid.Column="2" Style="{StaticResource ComposerPrimarySurface}" SemanticProperties.Description="Отправить" IsVisible="{Binding ShowSendButton}">
                <Path Data="M5,20 L22,12 L5,4 V10 L15,12 L5,14 Z" Fill="#020711" WidthRequest="22" HeightRequest="22" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSendClicked" /></Border.GestureRecognizers>
            </Border>
            <Border AutomationId="GroupChat.Voice" Grid.Column="2" Style="{StaticResource ComposerPrimarySurface}" SemanticProperties.Description="Голосовое сообщение" IsVisible="{Binding ShowVoiceButton}">
                <Path Data="M12,4 C10.3,4 9,5.3 9,7 V12 C9,13.7 10.3,15 12,15 C13.7,15 15,13.7 15,12 V7 C15,5.3 13.7,4 12,4 Z M6,11 C6,14.3 8.7,17 12,17 C15.3,17 18,14.3 18,11 M12,17 V21 M9,21 H15" Stroke="#020711" StrokeThickness="2" Fill="Transparent" WidthRequest="23" HeightRequest="23" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnVoiceClicked" /></Border.GestureRecognizers>
            </Border>
        </Grid>

        <Grid x:Name="AttachmentSheetOverlay" Grid.RowSpan="4" IsVisible="False" ZIndex="105">
            <BoxView Color="#99000000"><BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseAttachmentSheet" /></BoxView.GestureRecognizers></BoxView>
            <Border Style="{StaticResource AttachmentSheetBorder}" VerticalOptions="End">
                <VerticalStackLayout Spacing="13">
                    <BoxView Style="{StaticResource TelegramSheetHandle}" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="7" HorizontalOptions="Center">
                            <Border Style="{StaticResource AttachSheetIcon}">
                                <Path Data="M5,7 H23 V21 H5 Z M8,18 L12,14 L15,17 L17,15 L22,20 M10,10 A2,2 0 1 0 10,14 A2,2 0 1 0 10,10" Stroke="{StaticResource PrimaryColor}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="26" HeightRequest="26" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPickPhotoClicked" /></Border.GestureRecognizers>
                            </Border>
                            <Label Text="Галерея" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="7" HorizontalOptions="Center">
                            <Border Style="{StaticResource AttachSheetIcon}">
                                <Path Data="M5,8 H17 V20 H5 Z M17,11 L23,8 V20 L17,17 Z" Stroke="{StaticResource PrimaryColor}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="26" HeightRequest="26" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPickVideoClicked" /></Border.GestureRecognizers>
                            </Border>
                            <Label Text="Видео" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="7" HorizontalOptions="Center">
                            <Border Style="{StaticResource AttachSheetIcon}">
                                <Path Data="M8,4 H17 L22,9 V24 H8 Z M17,4 V9 H22 M11,16 H19 M11,20 H17" Stroke="{StaticResource PrimaryColor}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="26" HeightRequest="26" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPickFileClicked" /></Border.GestureRecognizers>
                            </Border>
                            <Label Text="Файл" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid x:Name="AttachmentActionOverlay" Grid.RowSpan="4" IsVisible="False" ZIndex="108">
            <BoxView Color="#99000000"><BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseAttachmentActionSheet" /></BoxView.GestureRecognizers></BoxView>
            <Border Style="{StaticResource AttachmentSheetBorder}" VerticalOptions="End">
                <VerticalStackLayout Spacing="8">
                    <BoxView Style="{StaticResource TelegramSheetHandle}" />
                    <Grid Padding="4,4,4,6" ColumnDefinitions="42,*,Auto" ColumnSpacing="10">
                        <Border WidthRequest="38" HeightRequest="38" Background="{StaticResource PageBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 19" VerticalOptions="Center">
                            <Path Data="M8,5 H19 L24,10 V27 H8 Z M19,5 V10 H24 M11,18 H21 M11,22 H18" Stroke="{StaticResource PrimaryColor}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="23" HeightRequest="23" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label x:Name="AttachmentActionTitle" Text="Вложение" FontSize="15" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                            <Label x:Name="AttachmentActionSubtitle" Text="" FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" Margin="44,0,0,0" />
                    <Grid Style="{StaticResource SheetActionRow}">
                        <Border Style="{StaticResource SheetIconCircle}">
                            <Path Data="M5,12 H19 M13,6 L19,12 L13,18" Stroke="{StaticResource PrimaryColor}" StrokeThickness="2" Fill="Transparent" WidthRequest="22" HeightRequest="22" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Открыть" FontSize="15" VerticalTextAlignment="Center" />
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnOpenAttachmentClicked" /></Grid.GestureRecognizers>
                    </Grid>
                    <Grid Style="{StaticResource SheetActionRow}">
                        <Border Style="{StaticResource SheetIconCircle}">
                            <Path Data="M12,5 V17 M7,10 L12,5 L17,10 M6,19 H18" Stroke="{StaticResource PrimaryColor}" StrokeThickness="2" Fill="Transparent" WidthRequest="22" HeightRequest="22" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Поделиться" FontSize="15" VerticalTextAlignment="Center" />
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnShareAttachmentClicked" /></Grid.GestureRecognizers>
                    </Grid>
                    <Grid Style="{StaticResource SheetActionRow}">
                        <Border Style="{StaticResource SheetIconCircle}">
                            <Path Data="M8,8 H19 V21 H8 Z M5,3 H16 V8" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="22" HeightRequest="22" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Копировать имя файла" FontSize="15" VerticalTextAlignment="Center" />
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnCopyAttachmentNameClicked" /></Grid.GestureRecognizers>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid x:Name="MessageMenuOverlay" Grid.RowSpan="4" IsVisible="False" ZIndex="110">
            <BoxView Color="#B3000000"><BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseMessageMenu" /></BoxView.GestureRecognizers></BoxView>
            <Border Style="{StaticResource ContextMenuBorder}" HorizontalOptions="Fill" VerticalOptions="End" Margin="12,0,12,68">
                <VerticalStackLayout Spacing="2">
                    <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Button Text="👍" CommandParameter="👍" Style="{StaticResource ReactionPickerButton}" Clicked="OnReactionClicked" />
