                                <Path Data="M5,8 H17 V20 H5 Z M17,11 L23,8 V20 L17,17 Z" Stroke="{StaticResource PrimaryColor}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="26" HeightRequest="26" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPickVideoClicked" /></Border.GestureRecognizers>
                            </Border>
                            <Label Text="Видео" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="7" HorizontalOptions="Center">
                            <Border Style="{StaticResource AttachSheetIcon}">
                                <Path Data="M8,4 H17 L22,9 V24 H8 Z M17,4 V9 H22 M11,16 H19 M11,20 H17" Stroke="{StaticResource PrimaryColor}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="26" HeightRequest="26" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPickFileClicked" /></Border.GestureRecognizers>
                            </Border>
                            <Label Text="Файл" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>
                    </Grid>
                </DataTemplate>
            </controls:DeferredView.Template>
        </controls:DeferredView>

        <controls:DeferredView x:Name="AttachmentActionOverlay" Grid.RowSpan="5" IsVisible="False" ZIndex="120">
