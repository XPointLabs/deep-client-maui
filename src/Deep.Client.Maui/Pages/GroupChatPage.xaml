                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnOpenAttachmentClicked" /></Grid.GestureRecognizers>
                    </Grid>
                    <Grid x:Name="SaveRow" Style="{StaticResource SheetActionRow}">
