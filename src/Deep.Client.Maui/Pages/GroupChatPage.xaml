                        <Label Grid.Column="1" Text="Копировать имя файла" FontSize="15" VerticalTextAlignment="Center" />
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnCopySelectedAttachmentName" /></Grid.GestureRecognizers>
                    </Grid>
                    <Grid x:Name="CopyTextRow" HeightRequest="46" ColumnDefinitions="32,*" Padding="10,0">
                        <Path Data="M8,8 H19 V21 H8 Z M5,3 H16 V8" Stroke="{StaticResource TextPrimary}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="22" HeightRequest="22" Aspect="Uniform" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Копировать" FontSize="15" VerticalTextAlignment="Center" />
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnCopySelectedMessage" /></Grid.GestureRecognizers>
                    </Grid>
                    <Grid HeightRequest="46" ColumnDefinitions="32,*" Padding="10,0">
                        <Path Data="M4,7 H20 M8,7 V4 H16 V7 M7,10 V20 H17 V10 M10,12 V18 M14,12 V18" Stroke="{StaticResource DangerColor}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="22" HeightRequest="22" Aspect="Uniform" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Удалить у меня" FontSize="15" TextColor="{StaticResource DangerColor}" VerticalTextAlignment="Center" />
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnDeleteSelectedMessage" /></Grid.GestureRecognizers>
                    </Grid>
                </VerticalStackLayout>
            </Border>
                    </Grid>
                </DataTemplate>
            </controls:DeferredView.Template>
        </controls:DeferredView>
    </Grid>
</ContentPage>
