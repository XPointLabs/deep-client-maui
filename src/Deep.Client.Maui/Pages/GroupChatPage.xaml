                </VerticalStackLayout>
            </Border>
                    </Grid>
                </DataTemplate>
            </controls:DeferredView.Template>
        </controls:DeferredView>

        <controls:DeferredView x:Name="MessageMenuOverlay" Grid.RowSpan="5" IsVisible="False" ZIndex="110">
            <controls:DeferredView.Template>
                <DataTemplate>
                    <Grid>
            <BoxView Color="#B3000000"><BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseMessageMenu" /></BoxView.GestureRecognizers></BoxView>
            <Border Style="{StaticResource ContextMenuBorder}" HorizontalOptions="Fill" VerticalOptions="End" Margin="12,0,12,68">
