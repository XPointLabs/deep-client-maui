                            <Path Data="M12,5 V17 M7,10 L12,5 L17,10 M6,19 H18" Stroke="{StaticResource PrimaryColor}" StrokeThickness="2" Fill="Transparent" WidthRequest="22" HeightRequest="22" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Поделиться" FontSize="15" VerticalTextAlignment="Center" />
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnShareAttachmentClicked" /></Grid.GestureRecognizers>
                    </Grid>
                    <Grid Style="{StaticResource SheetActionRow}">
                        <Border Style="{StaticResource SheetIconCircle}">
                            <Path Data="M8,8 H19 V21 H8 Z M5,3 H16 V8" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="22" HeightRequest="22" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Копировать имя файла" FontSize="15" VerticalTextAlignment="Center" />
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnCopyAttachmentNameClicked" /></Grid.GestureRecognizers>
                    </Grid>
                    <Grid x:Name="ReplyRow" Style="{StaticResource SheetActionRow}">
                        <Border Style="{StaticResource SheetIconCircle}">
                            <Path Data="M20,5 H10 C6,5 4,8 4,12 C4,16 7,19 11,19 H14 M9,14 L14,19 L9,24" Stroke="{StaticResource TextPrimary}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="22" HeightRequest="22" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Ответить" FontSize="15" VerticalTextAlignment="Center" />
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnReplyFromAttachmentClicked" /></Grid.GestureRecognizers>
                    </Grid>
                    <Grid x:Name="DeleteRow" Style="{StaticResource SheetActionRow}">
