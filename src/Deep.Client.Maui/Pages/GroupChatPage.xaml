                    <BoxView HeightRequest="1" Margin="42,0,0,0" Color="{StaticResource DividerColor}" />
                    <Grid HeightRequest="48" ColumnDefinitions="32,*" Padding="10,0">
                        <Path Data="M7,8 A5,5 0 1 0 17,8 A5,5 0 1 0 7,8 M4,21 C5.5,17 8.2,15 12,15 C15.8,15 18.5,17 20,21" Stroke="{StaticResource PrimaryColor}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="22" HeightRequest="22" Aspect="Uniform" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Участники группы" FontSize="15" VerticalTextAlignment="Center" />
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnToggleMembersClicked" /></Grid.GestureRecognizers>
