                            <Border Style="{StaticResource AttachSheetIcon}">
                                <Path Data="M5,7 H23 V21 H5 Z M8,18 L12,14 L15,17 L17,15 L22,20 M10,10 A2,2 0 1 0 10,14 A2,2 0 1 0 10,10" Stroke="{StaticResource PrimaryColor}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="26" HeightRequest="26" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPickPhotoClicked" /></Border.GestureRecognizers>
                            </Border>
                            <Label Text="Галерея" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
