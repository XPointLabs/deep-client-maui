                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnShareSelectedMessageAttachment" /></Grid.GestureRecognizers>
                    </Grid>
                    <Grid x:Name="CopyAttachmentNameRow" HeightRequest="46" ColumnDefinitions="32,*" Padding="10,0">
