                        <Label Grid.Column="1" Text="Открыть фото" FontSize="15" VerticalTextAlignment="Center" />
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnOpenSelectedMessageAttachment" /></Grid.GestureRecognizers>
                    </Grid>
                    <Grid x:Name="SaveAttachmentRow" HeightRequest="46" ColumnDefinitions="32,*" Padding="10,0">
