                        <Button Text="😮" CommandParameter="😮" Style="{StaticResource ReactionPickerButton}" Clicked="OnReactionClicked" />
                        <Button Text="😢" CommandParameter="😢" Style="{StaticResource ReactionPickerButton}" Clicked="OnReactionClicked" />
                    </HorizontalStackLayout>
                    <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" />
                    <Grid HeightRequest="46" ColumnDefinitions="32,*" Padding="10,0">
                        <Path Data="M20,5 H10 C6,5 4,8 4,12 C4,16 7,19 11,19 H14 M9,14 L14,19 L9,24" Stroke="{StaticResource TextPrimary}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="22" HeightRequest="22" Aspect="Uniform" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Ответить" FontSize="15" VerticalTextAlignment="Center" />
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnReplySelectedMessage" /></Grid.GestureRecognizers>
                    </Grid>
                    <Grid x:Name="OpenMediaRow" HeightRequest="46" ColumnDefinitions="32,*" Padding="10,0">
