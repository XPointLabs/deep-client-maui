<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Deep.Client.Maui.Pages.GroupChatPage"
    AutomationId="Page.GroupChat"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Deep.Client.Maui.Controls"
    xmlns:domain="clr-namespace:Deep.Client.Shared.Domain;assembly=Deep.Client.Shared"
    xmlns:vm="clr-namespace:Deep.Client.Maui.Core.ViewModels;assembly=Deep.Client.Maui.Core"
    x:DataType="vm:GroupChatViewModel"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.NavBarIsVisible="False"
    Title="Групповой чат">
    <ContentPage.Resources>
        <DataTemplate x:Key="GroupChatPlainTextMessageTemplate" x:DataType="vm:GroupChatMessageItem">
            <Grid Padding="2,0,2,4">
                <Border Background="{StaticResource IncomingBubbleColor}" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="11,7" HorizontalOptions="Start" MaximumWidthRequest="318">
                    <Border.Behaviors>
                        <controls:MessageContextGestureBehavior Invoked="OnMessageContextRequested" />
                    </Border.Behaviors>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding SenderLabel}" IsVisible="{Binding ShowSenderLabel}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" LineBreakMode="TailTruncation" />
                        <Label AutomationId="GroupChat.MessageBody" Text="{Binding Body}" FontSize="15" LineBreakMode="WordWrap" />
                        <HorizontalStackLayout Spacing="6" HorizontalOptions="End">
                            <Label Text="{Binding LocalCreatedAt, StringFormat='{}{0:HH:mm}'}" FontSize="10" TextColor="{StaticResource TextTertiary}" />
                            <Label Text="{Binding StatusGlyph}" IsVisible="{Binding IsStatusVisible}" SemanticProperties.Description="{Binding StatusDescription}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextTertiary}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsReadStatus}" Value="True"><Setter Property="TextColor" Value="{StaticResource PrimaryColor}" /></DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsFailedStatus}" Value="True"><Setter Property="TextColor" Value="{StaticResource DangerColor}" /></DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding Direction}" Value="{x:Static domain:MessageDirection.Outgoing}"><Setter Property="Background" Value="{StaticResource OutgoingBubbleColor}" /><Setter Property="HorizontalOptions" Value="End" /></DataTrigger>
                    </Border.Triggers>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GroupChatTextMessageTemplate" x:DataType="vm:GroupChatMessageItem">
            <Grid Padding="2,0,2,4">
                <Border Background="{StaticResource IncomingBubbleColor}" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="11,7" HorizontalOptions="Start" MaximumWidthRequest="318">
                    <Border.Behaviors>
                        <controls:MessageContextGestureBehavior Invoked="OnMessageContextRequested" />
                    </Border.Behaviors>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding SenderLabel}" IsVisible="{Binding ShowSenderLabel}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" LineBreakMode="TailTruncation" />
                        <Border Padding="8,5" Background="{StaticResource PanelBackgroundAlt}" StrokeThickness="0" StrokeShape="RoundRectangle 6" IsVisible="{Binding HasReply}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Ответ" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" />
                                <Label Text="{Binding ReplyPreview}" FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" MaxLines="2" />
                            </VerticalStackLayout>
                        </Border>
                        <Label AutomationId="GroupChat.MessageBody" Text="{Binding Body}" FontSize="15" LineBreakMode="WordWrap" />
                        <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center" IsVisible="{Binding HasReactions}" BindableLayout.ItemsSource="{Binding ReactionChips}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:MessageReactionChip">
                                    <Border Style="{StaticResource ReactionChip}" Margin="0,0,4,2">
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnReactionChipTapped" /></Border.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="4">
                                            <Label Text="{Binding Emoji}" FontSize="14" />
                                            <Label Text="{Binding Count}" FontSize="11" TextColor="{StaticResource TextSecondary}" VerticalTextAlignment="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        <HorizontalStackLayout Spacing="6" HorizontalOptions="End">
                            <Label Text="{Binding LocalCreatedAt, StringFormat='{}{0:HH:mm}'}" FontSize="10" TextColor="{StaticResource TextTertiary}" VerticalOptions="End" />
                            <Label Text="{Binding StatusGlyph}" IsVisible="{Binding IsStatusVisible}" SemanticProperties.Description="{Binding StatusDescription}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextTertiary}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsReadStatus}" Value="True"><Setter Property="TextColor" Value="{StaticResource PrimaryColor}" /></DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsFailedStatus}" Value="True"><Setter Property="TextColor" Value="{StaticResource DangerColor}" /></DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding Direction}" Value="{x:Static domain:MessageDirection.Outgoing}">
                            <Setter Property="Background" Value="{StaticResource OutgoingBubbleColor}" />
                            <Setter Property="HorizontalOptions" Value="End" />
                        </DataTrigger>
                    </Border.Triggers>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GroupChatImageMessageTemplate" x:DataType="vm:GroupChatMessageItem">
            <Grid Padding="2,0,2,4">
                <Border Background="{StaticResource IncomingBubbleColor}" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="6" HorizontalOptions="Start" MaximumWidthRequest="318">
                    <Border.Behaviors>
                        <controls:MessageContextGestureBehavior Invoked="OnMessageContextRequested" />
                    </Border.Behaviors>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding SenderLabel}" IsVisible="{Binding ShowSenderLabel}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" LineBreakMode="TailTruncation" />
                        <Border Padding="8,5" Margin="5,1" Background="{StaticResource PanelBackgroundAlt}" StrokeThickness="0" StrokeShape="RoundRectangle 6" IsVisible="{Binding HasReply}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Ответ" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" />
                                <Label Text="{Binding ReplyPreview}" FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" MaxLines="2" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Padding="0" StrokeThickness="0" Background="{StaticResource PanelBackgroundAlt}" StrokeShape="RoundRectangle 14">
                            <Grid WidthRequest="{Binding ImagePreviewWidthRequest}" HeightRequest="{Binding ImagePreviewHeightRequest}">
                                <Image Source="{Binding ImagePreviewPath}" Aspect="AspectFill" IsVisible="{Binding HasImagePreview}" WidthRequest="{Binding ImagePreviewWidthRequest}" HeightRequest="{Binding ImagePreviewHeightRequest}" />
                                <Grid IsVisible="{Binding IsImagePreviewLoading}" BackgroundColor="{StaticResource PanelBackgroundAlt}">
                                    <ActivityIndicator IsRunning="{Binding IsImagePreviewLoading}" Color="{StaticResource PrimaryColor}" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Grid>
                                <Border IsVisible="{Binding HasMultipleImages}" HorizontalOptions="End" VerticalOptions="Start" Margin="8" Padding="8,3" StrokeThickness="0" Background="#B3000000" StrokeShape="RoundRectangle 10">
                                    <Label Text="{Binding ImageCountLabel}" FontSize="11" FontAttributes="Bold" TextColor="White" />
                                </Border>
                            </Grid>
                            <Border.Behaviors>
                                <controls:MessageContextGestureBehavior Invoked="OnMessageContextRequested" />
                            </Border.Behaviors>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAttachmentTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Label Text="{Binding Body}" IsVisible="{Binding HasVisibleBody}" Margin="5,0" FontSize="15" LineBreakMode="WordWrap" />
                        <FlexLayout Margin="5,0" Direction="Row" Wrap="Wrap" AlignItems="Center" IsVisible="{Binding HasReactions}" BindableLayout.ItemsSource="{Binding ReactionChips}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:MessageReactionChip">
                                    <Border Style="{StaticResource ReactionChip}" Margin="0,0,4,2"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnReactionChipTapped" /></Border.GestureRecognizers><HorizontalStackLayout Spacing="4"><Label Text="{Binding Emoji}" FontSize="14" /><Label Text="{Binding Count}" FontSize="11" TextColor="{StaticResource TextSecondary}" /></HorizontalStackLayout></Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        <HorizontalStackLayout Margin="5,0" Spacing="6" HorizontalOptions="End">
                            <Label Text="{Binding LocalCreatedAt, StringFormat='{}{0:HH:mm}'}" FontSize="10" TextColor="{StaticResource TextTertiary}" />
                            <Label Text="{Binding StatusGlyph}" IsVisible="{Binding IsStatusVisible}" SemanticProperties.Description="{Binding StatusDescription}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextTertiary}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsReadStatus}" Value="True"><Setter Property="TextColor" Value="{StaticResource PrimaryColor}" /></DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsFailedStatus}" Value="True"><Setter Property="TextColor" Value="{StaticResource DangerColor}" /></DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding Direction}" Value="{x:Static domain:MessageDirection.Outgoing}"><Setter Property="Background" Value="{StaticResource OutgoingBubbleColor}" /><Setter Property="HorizontalOptions" Value="End" /></DataTrigger>
                    </Border.Triggers>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GroupChatVoiceMessageTemplate" x:DataType="vm:GroupChatMessageItem">
            <Grid Padding="2,0,2,4">
                <Border Background="{StaticResource IncomingBubbleColor}" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="11,7" HorizontalOptions="Start" MaximumWidthRequest="318">
                    <Border.Behaviors><controls:MessageContextGestureBehavior Invoked="OnMessageContextRequested" /></Border.Behaviors>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding SenderLabel}" IsVisible="{Binding ShowSenderLabel}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" LineBreakMode="TailTruncation" />
                        <Border Padding="8,5" Background="{StaticResource PanelBackgroundAlt}" StrokeThickness="0" StrokeShape="RoundRectangle 6" IsVisible="{Binding HasReply}"><VerticalStackLayout Spacing="2"><Label Text="Ответ" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" /><Label Text="{Binding ReplyPreview}" FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" MaxLines="2" /></VerticalStackLayout></Border>
                        <Border Style="{StaticResource AttachmentCard}">
                            <Grid ColumnDefinitions="38,*,Auto" ColumnSpacing="9">
                                <Border AutomationId="GroupChat.VoicePlayButton" WidthRequest="36" HeightRequest="36" Background="{StaticResource PrimaryColor}" StrokeThickness="0" StrokeShape="RoundRectangle 18" VerticalOptions="Center">
                                    <Grid WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center"><Path Data="M10,7 L23,18 L10,29 Z" Fill="#020711" WidthRequest="18" HeightRequest="18" Aspect="Uniform" IsVisible="{Binding IsVoiceIdle}" /><Path Data="M8,6 H11 V22 H8 Z M17,6 H20 V22 H17 Z" Fill="#020711" WidthRequest="18" HeightRequest="18" Aspect="Uniform" IsVisible="{Binding IsVoicePlaying}" /></Grid>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnVoiceMessageTapped" /></Border.GestureRecognizers>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Grid HeightRequest="18" ColumnDefinitions="3,3,3,3,3,3,3,3,3,3" ColumnSpacing="3"><BoxView HeightRequest="8" Color="{StaticResource PrimaryColor}" VerticalOptions="Center" /><BoxView Grid.Column="1" HeightRequest="14" Color="{StaticResource PrimaryColor}" VerticalOptions="Center" /><BoxView Grid.Column="2" HeightRequest="10" Color="{StaticResource PrimaryColor}" VerticalOptions="Center" /><BoxView Grid.Column="3" HeightRequest="18" Color="{StaticResource PrimaryColor}" VerticalOptions="Center" /><BoxView Grid.Column="4" HeightRequest="12" Color="{StaticResource PrimaryColor}" VerticalOptions="Center" /><BoxView Grid.Column="5" HeightRequest="16" Color="{StaticResource PrimaryColor}" VerticalOptions="Center" /><BoxView Grid.Column="6" HeightRequest="7" Color="{StaticResource PrimaryColor}" VerticalOptions="Center" /><BoxView Grid.Column="7" HeightRequest="13" Color="{StaticResource PrimaryColor}" VerticalOptions="Center" /><BoxView Grid.Column="8" HeightRequest="9" Color="{StaticResource PrimaryColor}" VerticalOptions="Center" /><BoxView Grid.Column="9" HeightRequest="17" Color="{StaticResource PrimaryColor}" VerticalOptions="Center" /></Grid>
                                    <ProgressBar AutomationId="GroupChat.VoiceProgress" Progress="{Binding VoicePlaybackProgress}" HeightRequest="3" ProgressColor="{StaticResource PrimaryColor}" BackgroundColor="{StaticResource DividerColor}" />
                                    <Label AutomationId="GroupChat.VoicePlaybackLabel" Text="{Binding VoicePlaybackLabel}" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                                <Path Grid.Column="2" Data="M12,4 C10.3,4 9,5.3 9,7 V12 C9,13.7 10.3,15 12,15 C13.7,15 15,13.7 15,12 V7 C15,5.3 13.7,4 12,4 Z M7,11 C7,13.8 9.2,16 12,16 C14.8,16 17,13.8 17,11 M12,16 V20" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.6" Fill="Transparent" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="End" />
                            </Grid>
                        </Border>
                        <Label Text="{Binding Body}" IsVisible="{Binding HasVisibleBody}" FontSize="15" LineBreakMode="WordWrap" />
                        <FlexLayout Direction="Row" Wrap="Wrap" IsVisible="{Binding HasReactions}" BindableLayout.ItemsSource="{Binding ReactionChips}"><BindableLayout.ItemTemplate><DataTemplate x:DataType="vm:MessageReactionChip"><Border Style="{StaticResource ReactionChip}" Margin="0,0,4,2"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnReactionChipTapped" /></Border.GestureRecognizers><HorizontalStackLayout Spacing="4"><Label Text="{Binding Emoji}" FontSize="14" /><Label Text="{Binding Count}" FontSize="11" TextColor="{StaticResource TextSecondary}" /></HorizontalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate></FlexLayout>
                        <HorizontalStackLayout Spacing="6" HorizontalOptions="End"><Label Text="{Binding LocalCreatedAt, StringFormat='{}{0:HH:mm}'}" FontSize="10" TextColor="{StaticResource TextTertiary}" /><Label Text="{Binding StatusGlyph}" IsVisible="{Binding IsStatusVisible}" SemanticProperties.Description="{Binding StatusDescription}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextTertiary}"><Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding IsReadStatus}" Value="True"><Setter Property="TextColor" Value="{StaticResource PrimaryColor}" /></DataTrigger><DataTrigger TargetType="Label" Binding="{Binding IsFailedStatus}" Value="True"><Setter Property="TextColor" Value="{StaticResource DangerColor}" /></DataTrigger></Label.Triggers></Label></HorizontalStackLayout>
                    </VerticalStackLayout>
                    <Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding Direction}" Value="{x:Static domain:MessageDirection.Outgoing}"><Setter Property="Background" Value="{StaticResource OutgoingBubbleColor}" /><Setter Property="HorizontalOptions" Value="End" /></DataTrigger></Border.Triggers>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GroupChatAttachmentMessageTemplate" x:DataType="vm:GroupChatMessageItem">
            <Grid Padding="2,0,2,4">
                <Border Background="{StaticResource IncomingBubbleColor}" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="11,7" HorizontalOptions="Start" MaximumWidthRequest="318">
                    <Border.Behaviors><controls:MessageContextGestureBehavior Invoked="OnMessageContextRequested" /></Border.Behaviors>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding SenderLabel}" IsVisible="{Binding ShowSenderLabel}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" LineBreakMode="TailTruncation" />
                        <Border Padding="8,5" Background="{StaticResource PanelBackgroundAlt}" StrokeThickness="0" StrokeShape="RoundRectangle 6" IsVisible="{Binding HasReply}"><VerticalStackLayout Spacing="2"><Label Text="Ответ" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" /><Label Text="{Binding ReplyPreview}" FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" MaxLines="2" /></VerticalStackLayout></Border>
                        <Border Style="{StaticResource AttachmentCard}">
                            <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="9"><Border WidthRequest="38" HeightRequest="38" Background="{StaticResource PrimaryColorMuted}" StrokeThickness="0" StrokeShape="RoundRectangle 19"><Path Data="M8,5 H19 L24,10 V27 H8 Z M19,5 V10 H24 M11,18 H21 M11,22 H18" Stroke="White" StrokeThickness="1.8" Fill="Transparent" WidthRequest="24" HeightRequest="24" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" /></Border><VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center"><Label Text="{Binding AttachmentTitle}" FontSize="13" FontAttributes="Bold" LineBreakMode="TailTruncation" /><Label Text="{Binding AttachmentSubtitle}" FontSize="11" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" /></VerticalStackLayout><Path Grid.Column="2" Data="M9,5 L16,12 L9,19" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" /></Grid>
                            <Border.Behaviors><controls:MessageContextGestureBehavior Invoked="OnMessageContextRequested" /></Border.Behaviors>
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAttachmentTapped" /></Border.GestureRecognizers>
                        </Border>
                        <Label Text="{Binding Body}" IsVisible="{Binding HasVisibleBody}" FontSize="15" LineBreakMode="WordWrap" />
                        <FlexLayout Direction="Row" Wrap="Wrap" IsVisible="{Binding HasReactions}" BindableLayout.ItemsSource="{Binding ReactionChips}"><BindableLayout.ItemTemplate><DataTemplate x:DataType="vm:MessageReactionChip"><Border Style="{StaticResource ReactionChip}" Margin="0,0,4,2"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnReactionChipTapped" /></Border.GestureRecognizers><HorizontalStackLayout Spacing="4"><Label Text="{Binding Emoji}" FontSize="14" /><Label Text="{Binding Count}" FontSize="11" TextColor="{StaticResource TextSecondary}" /></HorizontalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate></FlexLayout>
                        <HorizontalStackLayout Spacing="6" HorizontalOptions="End"><Label Text="{Binding LocalCreatedAt, StringFormat='{}{0:HH:mm}'}" FontSize="10" TextColor="{StaticResource TextTertiary}" /><Label Text="{Binding StatusGlyph}" IsVisible="{Binding IsStatusVisible}" SemanticProperties.Description="{Binding StatusDescription}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextTertiary}"><Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding IsReadStatus}" Value="True"><Setter Property="TextColor" Value="{StaticResource PrimaryColor}" /></DataTrigger><DataTrigger TargetType="Label" Binding="{Binding IsFailedStatus}" Value="True"><Setter Property="TextColor" Value="{StaticResource DangerColor}" /></DataTrigger></Label.Triggers></Label></HorizontalStackLayout>
                    </VerticalStackLayout>
                    <Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding Direction}" Value="{x:Static domain:MessageDirection.Outgoing}"><Setter Property="Background" Value="{StaticResource OutgoingBubbleColor}" /><Setter Property="HorizontalOptions" Value="End" /></DataTrigger></Border.Triggers>
                </Border>
            </Grid>
        </DataTemplate>

        <controls:MessageTemplateSelector
            x:Key="GroupChatMessageTemplateSelector"
            PlainTextTemplate="{StaticResource GroupChatPlainTextMessageTemplate}"
            TextTemplate="{StaticResource GroupChatTextMessageTemplate}"
            ImageTemplate="{StaticResource GroupChatImageMessageTemplate}"
            VoiceTemplate="{StaticResource GroupChatVoiceMessageTemplate}"
            AttachmentTemplate="{StaticResource GroupChatAttachmentMessageTemplate}" />
    </ContentPage.Resources>
    <Grid x:Name="PageLayout" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="0" BackgroundColor="{StaticResource PageBackground}">
        <VerticalStackLayout Grid.Row="0" Spacing="0">
            <Border x:Name="NetworkBanner" Padding="12,6" IsVisible="False" Background="{StaticResource PanelBackground}" StrokeThickness="0">
                <HorizontalStackLayout Spacing="7" HorizontalOptions="Center">
                    <Border WidthRequest="7" HeightRequest="7" StrokeThickness="0" Background="{StaticResource DangerColor}" StrokeShape="RoundRectangle 4" VerticalOptions="Center" />
                    <Label x:Name="NetworkBannerText" Text="Нет соединения" FontSize="12" TextColor="{StaticResource DangerColor}" />
                </HorizontalStackLayout>
            </Border>
            <Grid Style="{StaticResource CompactHeader}" ColumnDefinitions="40,42,*,40" ColumnSpacing="4">
                <Border AutomationId="GroupChat.Back" WidthRequest="40" HeightRequest="40" Padding="0" Background="Transparent" StrokeThickness="0" VerticalOptions="Center">
                    <Path Data="M15,4 L7,12 L15,20" Stroke="{StaticResource PrimaryColor}" StrokeThickness="2.4" Fill="Transparent" WidthRequest="22" HeightRequest="22" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBackClicked" /></Border.GestureRecognizers>
                </Border>
                <Border Grid.Column="1" WidthRequest="40" HeightRequest="40" Padding="0" StrokeThickness="0" Background="{StaticResource PrimaryColorMuted}" VerticalOptions="Center" StrokeShape="RoundRectangle 20">
                    <Label Text="G" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" FontSize="16" />
                </Border>
                <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center" Margin="5,0,0,0">
                    <Label Text="{Binding GroupTitle}" FontSize="16" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding GroupSubtitle}" FontSize="11" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
                <Button Grid.Column="3" AutomationId="GroupChat.Menu" Text="⋮" SemanticProperties.Description="Меню группы" Style="{StaticResource CircularIconButton}" Clicked="OnGroupMenuClicked" />
            </Grid>
            <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" />
        </VerticalStackLayout>

        <Border x:Name="MessageSearchBar" Grid.Row="1" IsVisible="False" Background="{StaticResource PanelBackground}" StrokeThickness="0" Padding="8,6">
            <Grid ColumnDefinitions="28,*,Auto,36,36,36" ColumnSpacing="4">
                <Path Data="M10,4 A6,6 0 1 0 10,16 A6,6 0 1 0 10,4 M14.5,14.5 L20,20" Stroke="{StaticResource TextSecondary}" StrokeThickness="2" Fill="Transparent" WidthRequest="22" HeightRequest="22" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                <Entry x:Name="MessageSearchEntry" Grid.Column="1" AutomationId="GroupChat.SearchMessages" Placeholder="Поиск сообщений" TextChanged="OnMessageSearchTextChanged" Completed="OnMessageSearchSubmitted" HeightRequest="38" BackgroundColor="Transparent" ReturnType="Search" />
                <Label x:Name="MessageSearchCountLabel" Grid.Column="2" Text="" FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalTextAlignment="Center" Margin="4,0,2,0" />
                <Border Grid.Column="3" WidthRequest="36" HeightRequest="36" Background="Transparent" StrokeThickness="0" SemanticProperties.Description="Предыдущее совпадение">
                    <Path Data="M7,14 L12,9 L17,14" Stroke="{StaticResource PrimaryColor}" StrokeThickness="2.1" Fill="Transparent" WidthRequest="20" HeightRequest="20" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnMessageSearchPreviousClicked" /></Border.GestureRecognizers>
                </Border>
                <Border Grid.Column="4" WidthRequest="36" HeightRequest="36" Background="Transparent" StrokeThickness="0" SemanticProperties.Description="Следующее совпадение">
                    <Path Data="M7,10 L12,15 L17,10" Stroke="{StaticResource PrimaryColor}" StrokeThickness="2.1" Fill="Transparent" WidthRequest="20" HeightRequest="20" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnMessageSearchNextClicked" /></Border.GestureRecognizers>
                </Border>
                <Border Grid.Column="5" WidthRequest="36" HeightRequest="36" Background="Transparent" StrokeThickness="0" SemanticProperties.Description="Закрыть поиск">
                    <Path Data="M7,7 L17,17 M17,7 L7,17" Stroke="{StaticResource TextSecondary}" StrokeThickness="2" Fill="Transparent" WidthRequest="20" HeightRequest="20" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseMessageSearchClicked" /></Border.GestureRecognizers>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <Border x:Name="MembersPanel" Grid.Row="0" Background="{StaticResource PanelBackground}" Stroke="{StaticResource DividerColor}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="10" Margin="10,8,10,2" IsVisible="False">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                    <Label Text="{Binding StatusMessage}" FontSize="12" TextColor="{StaticResource PrimaryColor}" LineBreakMode="TailTruncation">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsStatusError}" Value="True"><Setter Property="TextColor" Value="{StaticResource DangerColor}" /></DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Border Background="{StaticResource SearchBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,0">
                            <Entry AutomationId="GroupChat.MemberSessionId" Placeholder="ID участника" Text="{Binding MemberSessionId}" HeightRequest="42" BackgroundColor="Transparent" />
                        </Border>
                        <Button Grid.Column="1" Text="Добавить" Command="{Binding AddMemberCommand}" WidthRequest="108" />
                    </Grid>
                    <CollectionView Grid.Row="2" ItemsSource="{Binding Members}" ItemSizingStrategy="MeasureFirstItem" HeightRequest="86" SelectionMode="Single" SelectedItem="{Binding SelectedMember, Mode=TwoWay}" SelectionChanged="OnMemberSelectionChanged">
                        <CollectionView.EmptyView><Label Text="Нет участников" FontSize="12" TextColor="{StaticResource TextSecondary}" /></CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:GroupMemberItem">
                                <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,0,0,4" ColumnSpacing="6">
                                    <Label Text="{Binding SessionId.Value}" FontSize="11" LineBreakMode="TailTruncation" />
                                    <Border Grid.Column="1" StrokeThickness="0" Padding="6,2" Background="{StaticResource PanelBackgroundAlt}" StrokeShape="RoundRectangle 8"><Label Text="{Binding Role}" FontSize="10" TextColor="{StaticResource TextSecondary}" /></Border>
                                    <Border Grid.Column="2" StrokeThickness="0" Padding="6,2" Background="{StaticResource DangerColor}" StrokeShape="RoundRectangle 8" IsVisible="{Binding IsPendingRemoval}"><Label Text="Ожидает" FontSize="10" TextColor="#050705" /></Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>

            <CollectionView x:Name="MessagesCollection" AutomationId="GroupChat.Messages" Grid.Row="1" Margin="8,4" ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource GroupChatMessageTemplateSelector}" ItemsUpdatingScrollMode="KeepItemsInView" Scrolled="OnMessagesScrolled">
            <CollectionView.EmptyView>
                <Grid Padding="0,70,0,0">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                        <Image Source="deep_mark.png" WidthRequest="42" HeightRequest="42" Opacity="0.8" />
                        <Label Text="Пока нет сообщений" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="Начните защищенную групповую переписку" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
            </CollectionView.EmptyView>
            </CollectionView>
        </Grid>

        <Grid Grid.Row="3" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="5" Padding="8,4,8,0" BackgroundColor="{StaticResource PageBackground}">
            <Border Grid.Row="0" Background="{StaticResource PanelBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,7" IsVisible="{Binding IsReplying}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <BoxView WidthRequest="3" Color="{StaticResource PrimaryColor}" />
                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                        <Label Text="Ответ" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" />
                        <Label Text="{Binding ReplyingToPreview}" FontSize="13" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2" Text="×" SemanticProperties.Description="Отменить ответ" Command="{Binding CancelReplyCommand}" WidthRequest="38" HeightRequest="38" Padding="0" Style="{StaticResource GhostButton}" />
                </Grid>
            </Border>
            <Border Grid.Row="1" Background="{StaticResource PanelBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,7" IsVisible="{Binding HasStagedAttachments}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding StagedAttachments}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="domain:AttachmentMetadata">
                                <Border Background="{StaticResource PanelBackgroundAlt}" Stroke="{StaticResource DividerColor}" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="9,5">
                                    <HorizontalStackLayout Spacing="6">
                                        <Path Data="M8,5 H18 L23,10 V25 H8 Z M18,5 V10 H23" Stroke="{StaticResource PrimaryColor}" StrokeThickness="1.7" Fill="Transparent" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" />
                                        <Label Text="{Binding FileName}" FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" MaxLines="1" WidthRequest="150" />
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                    <Button Grid.Column="1" Text="Очистить" Command="{Binding ClearAttachmentsCommand}" WidthRequest="96" Style="{StaticResource SecondaryButton}" />
                </Grid>
            </Border>
            <Border x:Name="VoiceRecordingPanel" Grid.Row="2" Style="{StaticResource VoiceRecordingPanel}" IsVisible="{Binding IsRecordingVoice}">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="9">
                    <Border WidthRequest="10" HeightRequest="10" Background="{StaticResource DangerColor}" StrokeThickness="0" StrokeShape="RoundRectangle 5" VerticalOptions="Center" />
                    <Label x:Name="VoiceElapsedLabel" Grid.Column="1" Text="00:00" FontSize="14" TextColor="{StaticResource TextPrimary}" VerticalTextAlignment="Center" />
                    <HorizontalStackLayout Grid.Column="2" Spacing="3" HeightRequest="24" VerticalOptions="Center">
                        <BoxView Style="{StaticResource VoiceWaveBar}" HeightRequest="8" />
                        <BoxView Style="{StaticResource VoiceWaveBar}" HeightRequest="15" />
                        <BoxView Style="{StaticResource VoiceWaveBar}" HeightRequest="11" />
                        <BoxView Style="{StaticResource VoiceWaveBar}" HeightRequest="20" />
                        <BoxView Style="{StaticResource VoiceWaveBar}" HeightRequest="13" />
                        <BoxView Style="{StaticResource VoiceWaveBar}" HeightRequest="17" />
                        <BoxView Style="{StaticResource VoiceWaveBar}" HeightRequest="9" />
                        <Label x:Name="VoiceSlideHintLabel" Text="Сдвиньте влево для отмены" FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalTextAlignment="Center" Margin="5,0,0,0" />
                    </HorizontalStackLayout>
                    <Border x:Name="VoiceCancelPill" Grid.Column="3" Padding="10,5" StrokeThickness="0" Background="{StaticResource PanelBackgroundAlt}" StrokeShape="RoundRectangle 14" VerticalOptions="Center">
                        <Label Text="Отмена" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    </Border>
                </Grid>
            </Border>
            <Label Grid.Row="3" AutomationId="GroupChat.Error" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource DangerColor}" FontSize="12" LineBreakMode="WordWrap" Margin="8,0" />
        </Grid>
        <Grid Grid.Row="4" HeightRequest="56" MinimumHeightRequest="56" Padding="8,4,8,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7" BackgroundColor="{StaticResource PageBackground}">
            <Border AutomationId="GroupChat.Attach" Style="{StaticResource ComposerIconSurface}" SemanticProperties.Description="Добавить вложение">
                <Path Data="M12,5 V19 M5,12 H19" Stroke="{StaticResource PrimaryColor}" StrokeThickness="2.4" StrokeLineCap="Round" Fill="Transparent" WidthRequest="24" HeightRequest="24" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAttachClicked" /></Border.GestureRecognizers>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource SearchBackground}" Stroke="{StaticResource DividerColor}" StrokeThickness="1" StrokeShape="RoundRectangle 21" Padding="10,0">
                <Entry x:Name="DraftEntry" AutomationId="GroupChat.Draft" Placeholder="Сообщение" Text="{Binding Draft}" HeightRequest="42" BackgroundColor="Transparent" ReturnType="Send" ReturnCommand="{Binding SendCommand}" />
            </Border>
            <Border AutomationId="GroupChat.Send" Grid.Column="2" Style="{StaticResource ComposerPrimarySurface}" SemanticProperties.Description="Отправить" IsVisible="{Binding ShowSendButton}">
                <Path Data="M5,20 L22,12 L5,4 V10 L15,12 L5,14 Z" Fill="#020711" WidthRequest="22" HeightRequest="22" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSendClicked" /></Border.GestureRecognizers>
            </Border>
            <Border x:Name="VoiceButton" AutomationId="GroupChat.Voice" Grid.Column="2" Style="{StaticResource ComposerPrimarySurface}" SemanticProperties.Description="Голосовое сообщение" IsVisible="{Binding ShowVoiceButton}">
                <Path Data="M12,4 C10.3,4 9,5.3 9,7 V12 C9,13.7 10.3,15 12,15 C13.7,15 15,13.7 15,12 V7 C15,5.3 13.7,4 12,4 Z M6,11 C6,14.3 8.7,17 12,17 C15.3,17 18,14.3 18,11 M12,17 V21 M9,21 H15" Stroke="#020711" StrokeThickness="2" Fill="Transparent" WidthRequest="23" HeightRequest="23" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <PointerGestureRecognizer PointerPressed="OnVoicePointerPressed" PointerMoved="OnVoicePointerMoved" PointerReleased="OnVoicePointerReleased" />
                    <PanGestureRecognizer PanUpdated="OnVoicePanUpdated" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <controls:DeferredView x:Name="AttachmentSheetOverlay" Grid.RowSpan="5" IsVisible="False" ZIndex="105">
            <controls:DeferredView.Template>
                <DataTemplate>
                    <Grid>
            <BoxView Color="#99000000"><BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseAttachmentSheet" /></BoxView.GestureRecognizers></BoxView>
            <Border Style="{StaticResource AttachmentSheetBorder}" VerticalOptions="End">
                <VerticalStackLayout Spacing="13">
                    <BoxView Style="{StaticResource TelegramSheetHandle}" />
