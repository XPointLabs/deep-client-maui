<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Deep.Client.Maui.Pages.NewConversationPage"
    AutomationId="Page.NewConversation"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Deep.Client.Maui.Core.ViewModels;assembly=Deep.Client.Maui.Core"
    x:DataType="vm:NewConversationViewModel"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.NavBarIsVisible="False"
    Title="Новое сообщение">
    <Grid RowDefinitions="Auto,*" RowSpacing="0" BackgroundColor="{StaticResource PageBackground}">
        <Grid Style="{StaticResource CompactHeader}" ColumnDefinitions="40,*,40" ColumnSpacing="8">
            <Border
                AutomationId="NewConversation.Back"
                WidthRequest="40"
                HeightRequest="40"
                Padding="0"
                Background="Transparent"
                StrokeThickness="0"
                VerticalOptions="Center">
                <Path Data="M15,4 L7,12 L15,20" Stroke="{StaticResource PrimaryColor}" StrokeThickness="2.4" Fill="Transparent" WidthRequest="22" HeightRequest="22" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </Border.GestureRecognizers>
            </Border>
            <Label Grid.Column="1" Text="Новое сообщение" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalOptions="Center" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="16" Padding="16,20,16,0">
            <VerticalStackLayout Spacing="6">
                <Label Text="Кому" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                <Entry
                    x:Name="DeepIdEntry"
                    AutomationId="NewConversation.SessionId"
                    Placeholder="deep1… или deepinvite:…"
                    IsEnabled="{Binding CanEditAddress}"
                    Text="{Binding AddressInput, Mode=TwoWay}" />
            </VerticalStackLayout>

            <Button
                x:Name="ImportButton"
                AutomationId="NewConversation.Start"
                Text="Добавить контакт"
                IsVisible="{Binding ShowResolveAction}"
                IsEnabled="{Binding CanResolve}"
                Clicked="OnResolveClicked" />

            <ActivityIndicator
                AutomationId="NewConversation.Resolving"
                IsVisible="{Binding IsBusy}"
                IsRunning="{Binding IsBusy}"
                Color="{StaticResource PrimaryColor}" />

            <Border
                AutomationId="NewConversation.Status"
                IsVisible="{Binding HasStatus}"
                Padding="12"
                Background="{StaticResource PanelBackground}"
                Stroke="{StaticResource DividerColor}"
                StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="6">
                    <Label
                        AutomationId="NewConversation.StatusTitle"
                        Text="{Binding StatusTitle}"
                        FontAttributes="Bold" />
                    <Label
                        AutomationId="NewConversation.StatusMessage"
                        Text="{Binding StatusMessage}"
                        FontSize="13"
                        TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
            </Border>

            <Button
                AutomationId="NewConversation.Retry"
                Text="Повторить проверку"
                IsVisible="{Binding CanRetry}"
                IsEnabled="{Binding CanRetry}"
                Clicked="OnResolveClicked" />

            <Label
                AutomationId="NewConversation.Error"
                IsVisible="{Binding HasError}"
                Text="{Binding ErrorMessage}"
                TextColor="{StaticResource DangerColor}"
                FontSize="13" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
