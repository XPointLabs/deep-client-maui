<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Deep.Client.Maui.Pages.GroupsPage"
    AutomationId="Page.Groups"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Deep.Client.Maui.Core.ViewModels;assembly=Deep.Client.Maui.Core"
    x:DataType="vm:GroupsViewModel"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.NavBarIsVisible="False"
    Title="Новая группа">
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10" BackgroundColor="{StaticResource PageBackground}">
        <Border x:Name="NetworkBanner" Grid.Row="0" Padding="12,6" IsVisible="False" Background="{StaticResource PanelBackground}" StrokeThickness="0">
            <HorizontalStackLayout Spacing="7" HorizontalOptions="Center">
                <Border WidthRequest="7" HeightRequest="7" StrokeThickness="0" Background="{StaticResource DangerColor}" StrokeShape="RoundRectangle 4" VerticalOptions="Center" />
                <Label x:Name="NetworkBannerText" Text="Нет соединения" FontSize="12" TextColor="{StaticResource DangerColor}" />
            </HorizontalStackLayout>
        </Border>

        <Grid Grid.Row="1" Style="{StaticResource CompactHeader}" ColumnDefinitions="40,*,40" ColumnSpacing="8">
            <Border
                AutomationId="Groups.Back"
                WidthRequest="40"
                HeightRequest="40"
                Padding="0"
                Background="Transparent"
                StrokeThickness="0"
                VerticalOptions="Center">
                <Path Data="M15,4 L7,12 L15,20" Stroke="{StaticResource PrimaryColor}" StrokeThickness="2.4" Fill="Transparent" WidthRequest="22" HeightRequest="22" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </Border.GestureRecognizers>
            </Border>

            <Label Grid.Column="1" Text="Новая группа" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalOptions="Center" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="12" Margin="16,0">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                <Label Text="Создать закрытую группу" FontSize="16" FontAttributes="Bold" />

                <Label
                    AutomationId="Groups.ComposerStatus"
                    Grid.Row="1"
                    Text="{Binding ComposerStatus}"
                    FontSize="12"
                    TextColor="{StaticResource TextSecondary}" />

                <Entry
                    x:Name="GroupNameEntry"
                    AutomationId="Groups.GroupName"
                    Grid.Row="2"
                    Placeholder="Название группы"
                    Text="{Binding GroupName}"
                    ReturnType="Next" />

                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry
                        x:Name="MemberAddressEntry"
                        AutomationId="Groups.MemberAddress"
                        Placeholder="canonical deep1… или deepinvite:DIA1"
                        Text="{Binding MemberAddress}"
                        ReturnType="Done"
                        ReturnCommand="{Binding AddDraftMemberCommand}" />
                    <Button
                        AutomationId="Groups.AddMember"
                        Grid.Column="1"
                        Text="Добавить"
                        Command="{Binding AddDraftMemberCommand}"
                        IsEnabled="{Binding CanAddMember}"
                        WidthRequest="82" />
                </Grid>

                <CollectionView
                    AutomationId="Groups.DraftMembers"
                    Grid.Row="4"
                    ItemsSource="{Binding DraftMembers}"
                    ItemSizingStrategy="MeasureFirstItem"
                    IsVisible="{Binding HasDraftMembers}"
                    SelectionMode="Single"
                    SelectedItem="{Binding SelectedDraftMember, Mode=TwoWay}"
                    SelectionChanged="OnDraftMemberSelectionChanged"
                    HeightRequest="90">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:GroupDraftMemberItem">
                            <Grid ColumnDefinitions="*,Auto" Padding="0,3" ColumnSpacing="8">
                                <Label Text="{Binding DisplayName}" FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                <Border Grid.Column="1" StrokeThickness="0" Background="{StaticResource PanelBackgroundAlt}" Padding="10,4" StrokeShape="RoundRectangle 12">
                                    <Label Text="Удалить" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button
                    AutomationId="Groups.Create"
                    Grid.Row="5"
                    Text="Создать группу"
                    IsEnabled="{Binding CanCreateGroup}"
                    Clicked="OnCreateGroupClicked"
                    HeightRequest="46" />

                <Label
                    AutomationId="Groups.OperationStatus"
                    Grid.Row="6"
                    Text="{Binding OperationStatus}"
                    IsVisible="{Binding HasOperationStatus}"
                    FontSize="12"
                    TextColor="{StaticResource TextSecondary}" />
            </Grid>
        </Border>

        <CollectionView Grid.Row="3" Margin="4,0" ItemsSource="{Binding Groups}" ItemSizingStrategy="MeasureFirstItem" SelectionMode="Single" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" SelectionChanged="OnGroupSelectionChanged">
            <CollectionView.EmptyView>
                <Grid Padding="0,80,0,0">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Start">
                        <Label Text="Пока нет групп" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="Создайте GroupV1; GroupChat/fanout подключается отдельным срезом." FontSize="14" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:GroupListItem">
                    <Border Style="{StaticResource ConversationRowBorder}">
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="3">
                            <Border Grid.RowSpan="2" WidthRequest="52" HeightRequest="52" Padding="0" StrokeThickness="0" Background="{StaticResource PrimaryColorMuted}" VerticalOptions="Center" StrokeShape="RoundRectangle 26">
                                <Label Text="G" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" FontSize="20" />
                            </Border>
                            <Label Grid.Column="1" Text="{Binding Name}" FontAttributes="Bold" FontSize="17" LineBreakMode="TailTruncation" />
                            <Label Grid.Column="2" Text="{Binding MemberCount, StringFormat='{}{0} активн.'}" TextColor="{StaticResource TextSecondary}" FontSize="12" />
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="8">
                                <Label Text="{Binding PendingInvitationCount, StringFormat='{}{0} приглашений ожидают fanout'}" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="Конфликт ветки" FontSize="14" TextColor="{StaticResource DangerColor}" IsVisible="False">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasForkConflict}" Value="True">
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
