<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Deep.Client.Maui.Pages.CallPage"
    AutomationId="Page.Call"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#07111F"
    Shell.NavBarIsVisible="False">
    <Grid>
        <HybridWebView
            x:Name="CallWebView"
            AutomationId="Call.Media"
            HybridRoot="wwwroot"
            DefaultFile="call/index.html"
            RawMessageReceived="OnRawMessageReceived" />

        <Grid
            Padding="12,14"
            ColumnDefinitions="48,*,48"
            VerticalOptions="Start"
            BackgroundColor="#66020A14">
            <Border
                WidthRequest="44"
                HeightRequest="44"
                Padding="0"
                StrokeThickness="0"
                Background="#52000000"
                StrokeShape="RoundRectangle 22">
                <Path Data="M15,4 L7,12 L15,20" Stroke="White" StrokeThickness="2.2" Fill="Transparent" WidthRequest="22" HeightRequest="22" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </Border.GestureRecognizers>
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label x:Name="DisplayNameLabel" Text="Звонок Deep" FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                <Label x:Name="StatusLabel" Text="Подключение..." FontSize="13" TextColor="#C8D2DE" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <Label Grid.Column="2" x:Name="DurationLabel" Text="" FontSize="12" TextColor="#C8D2DE" VerticalOptions="Center" HorizontalTextAlignment="Center" />
        </Grid>

        <Border
            Padding="18,14,18,28"
            StrokeThickness="0"
            VerticalOptions="End"
            HorizontalOptions="Fill"
            Background="#8A020A14">
            <HorizontalStackLayout Spacing="24" HorizontalOptions="Center">
                <Border x:Name="MicrophoneButton" WidthRequest="56" HeightRequest="56" Padding="0" StrokeThickness="0" Background="#E8F0F7" StrokeShape="RoundRectangle 28" SemanticProperties.Description="Выключить микрофон">
                    <Path x:Name="MicrophoneIcon" Data="M12,3 A3,3 0 0 0 9,6 V12 A3,3 0 0 0 15,12 V6 A3,3 0 0 0 12,3 M6,11 V12 A6,6 0 0 0 18,12 V11 M12,18 V22 M9,22 H15" Stroke="#07111F" StrokeThickness="2" Fill="Transparent" WidthRequest="24" HeightRequest="24" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnMicrophoneClicked" /></Border.GestureRecognizers>
                </Border>

                <Border x:Name="CameraButton" WidthRequest="56" HeightRequest="56" Padding="0" StrokeThickness="0" Background="#E8F0F7" StrokeShape="RoundRectangle 28" SemanticProperties.Description="Выключить камеру">
                    <Path x:Name="CameraIcon" Data="M3,6 H15 V18 H3 Z M15,10 L21,6 V18 L15,14 Z" Stroke="#07111F" StrokeThickness="2" Fill="Transparent" WidthRequest="24" HeightRequest="24" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCameraClicked" /></Border.GestureRecognizers>
                </Border>

                <Border x:Name="SwitchCameraButton" WidthRequest="56" HeightRequest="56" Padding="0" StrokeThickness="0" Background="#33455A" StrokeShape="RoundRectangle 28" SemanticProperties.Description="Переключить камеру">
                    <Path Data="M5,8 A8,8 0 0 1 18,6 L21,6 L21,3 M19,16 A8,8 0 0 1 6,18 L3,18 L3,21 M8,9 H16 V16 H8 Z" Stroke="White" StrokeThickness="2" Fill="Transparent" WidthRequest="24" HeightRequest="24" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSwitchCameraClicked" /></Border.GestureRecognizers>
                </Border>

                <Border WidthRequest="56" HeightRequest="56" Padding="0" StrokeThickness="0" Background="#E53935" StrokeShape="RoundRectangle 28" SemanticProperties.Description="Завершить звонок">
                    <Path Data="M5,13 C8,9 16,9 19,13 L17,17 L14,15 C13,14 11,14 10,15 L7,17 Z" Stroke="White" StrokeThickness="2" Fill="White" WidthRequest="25" HeightRequest="25" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" Rotation="135" />
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnHangupClicked" /></Border.GestureRecognizers>
                </Border>
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentPage>
