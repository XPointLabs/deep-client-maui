<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Deep.Client.Maui.Pages.DesktopWorkspacePage"
    AutomationId="Page.DesktopWorkspace"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Deep.Client.Maui.Controls"
    xmlns:vm="clr-namespace:Deep.Client.Maui.Core.ViewModels;assembly=Deep.Client.Maui.Core"
    x:DataType="vm:DesktopWorkspaceViewModel"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.NavBarIsVisible="False"
    Title="Диалоги">

    <Grid
        x:Name="WorkspaceRoot"
        AutomationId="DesktopWorkspace.Root"
        ColumnDefinitions="320,9,*"
        BackgroundColor="{StaticResource PageBackground}"
        SizeChanged="OnWorkspaceSizeChanged">

        <Grid
            x:Name="ConversationListPane"
            AutomationId="Conversations.Root"
            Grid.Column="0"
            RowDefinitions="Auto,Auto,*"
            BackgroundColor="{StaticResource PageBackground}"
            IsVisible="{Binding IsConversationListVisible}">
            <Grid AutomationId="DesktopWorkspace.ListPane" Grid.Row="0" HeightRequest="56" Padding="14,6,10,6" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Border WidthRequest="40" HeightRequest="40" Padding="0" StrokeThickness="0" Background="{StaticResource AvatarAccentColor}" StrokeShape="RoundRectangle 20">
                    <Label Text="{Binding ConversationList.AccountInitial}" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" FontSize="16" />
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnOpenSettingsClicked" /></Border.GestureRecognizers>
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                    <Label Text="Deep" FontSize="18" FontAttributes="Bold" />
                    <Label Text="XPoint Network" FontSize="11" TextColor="{StaticResource TextTertiary}" />
                </VerticalStackLayout>
                <Button
                    Grid.Column="2"
                    AutomationId="Conversations.NewConversation"
                    Text="+"
                    Style="{StaticResource ToolbarIconButton}"
                    FontSize="24"
                    SemanticProperties.Description="Новое сообщение"
                    Clicked="OnNewConversationClicked" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource SearchBorder}" Margin="10,3,10,8">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Text="⌕" FontSize="21" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                    <Entry
                        Grid.Column="1"
                        AutomationId="DesktopWorkspace.ConversationSearch"
                        Placeholder="Поиск"
                        Text="{Binding ConversationList.SearchQuery}"
                        HeightRequest="38"
                        Margin="0"
                        BackgroundColor="Transparent" />
                </Grid>
            </Border>

            <RefreshView
                Grid.Row="2"
                AutomationId="DesktopWorkspace.ConversationList"
                IsRefreshing="{Binding ConversationList.IsManualRefreshing, Mode=OneWay}"
                Command="{Binding ConversationList.ManualRefreshCommand}"
                RefreshColor="{StaticResource PrimaryColor}">
                <CollectionView
                    x:Name="ConversationCollection"
                    AutomationId="Conversations.List"
                    ItemsSource="{Binding ConversationList.Conversations}"
                    ItemSizingStrategy="MeasureFirstItem"
                    SelectedItem="{Binding ConversationList.SelectedConversation, Mode=TwoWay}"
                    SelectionMode="Single"
                    SelectionChanged="OnConversationSelectionChanged">
                    <CollectionView.EmptyView>
                        <Grid Padding="36,72,36,0">
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Start">
                                <Label Text="Нет диалогов" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                <Label Text="Начните новую переписку" FontSize="13" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConversationListItem">
                            <Border x:Name="ConversationRow" Padding="10,8" StrokeThickness="0" Background="{StaticResource PageBackground}" SemanticProperties.Description="{Binding Title}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PressedBackground}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid HeightRequest="46" ColumnDefinitions="46,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="2">
                                    <Border Grid.RowSpan="2" WidthRequest="46" HeightRequest="46" Padding="0" StrokeThickness="0" Background="{StaticResource PrimaryColorMuted}" StrokeShape="RoundRectangle 23">
                                        <Label Text="{Binding AvatarInitial}" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" FontSize="17" />
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding Title}" FontSize="15" FontAttributes="Bold" MaxLines="1" LineBreakMode="TailTruncation" VerticalOptions="End" />
                                    <Label Grid.Column="2" Text="{Binding LocalUpdatedAt, StringFormat='{}{0:HH:mm}'}" FontSize="11" TextColor="{StaticResource TextTertiary}" VerticalOptions="End" />
                                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                        <Label Text="{Binding LastMessagePreview}" FontSize="13" TextColor="{StaticResource TextSecondary}" MaxLines="1" LineBreakMode="TailTruncation" />
                                        <Border Grid.Column="1" MinimumWidthRequest="19" HeightRequest="19" Padding="5,0" StrokeThickness="0" Background="{StaticResource PrimaryColor}" StrokeShape="RoundRectangle 10">
                                            <Label Text="{Binding UnreadCount}" FontSize="10" TextColor="#03101A" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding UnreadCount}" Value="0"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                            </Border.Triggers>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>

        <Grid
            x:Name="ConversationPaneSplitter"
            AutomationId="DesktopWorkspace.Splitter"
            Grid.Column="1"
            BackgroundColor="Transparent"
            IsVisible="{Binding IsSplitView}">
            <BoxView WidthRequest="1" HorizontalOptions="Center" Color="{StaticResource DividerColor}" />
            <Grid.GestureRecognizers>
                <PointerGestureRecognizer PointerPressed="OnSplitterPointerPressed" PointerMoved="OnSplitterPointerMoved" PointerReleased="OnSplitterPointerReleased" />
            </Grid.GestureRecognizers>
        </Grid>

        <Grid
            x:Name="DetailPane"
            AutomationId="DesktopWorkspace.DetailPane"
            Grid.Column="2"
            RowDefinitions="Auto,Auto,*"
            BackgroundColor="{StaticResource PanelBackground}"
            IsVisible="{Binding IsDetailPaneVisible}">

            <Grid Grid.Row="0" HeightRequest="56" Padding="8,5,8,5" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="4" BackgroundColor="{StaticResource PageBackground}">
                <Button
                    AutomationId="DesktopWorkspace.Back"
                    Text="‹"
                    Style="{StaticResource ToolbarIconButton}"
                    FontSize="30"
                    IsVisible="{Binding IsBackButtonVisible}"
                    SemanticProperties.Description="Назад к диалогам"
                    Clicked="OnBackToListClicked" />
                <Border Grid.Column="1" WidthRequest="40" HeightRequest="40" Padding="0" StrokeThickness="0" Background="{StaticResource PrimaryColorMuted}" StrokeShape="RoundRectangle 20" VerticalOptions="Center" IsVisible="{Binding HasSelectedDetail}">
                    <Label Text="{Binding SelectedConversation.AvatarInitial}" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" FontSize="16" />
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDetailHeaderTapped" /></Border.GestureRecognizers>
                </Border>
                <Grid Grid.Column="2" Margin="6,0,8,0" VerticalOptions="Center">
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnDetailHeaderTapped" /></Grid.GestureRecognizers>
                    <VerticalStackLayout Spacing="0" IsVisible="{Binding IsDirectDetail}">
                        <Label Text="{Binding DirectChat.ConversationTitle}" FontSize="15" FontAttributes="Bold" MaxLines="1" LineBreakMode="TailTruncation" />
                        <Label Text="личный чат" FontSize="11" TextColor="{StaticResource TextTertiary}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="0" IsVisible="{Binding IsGroupDetail}">
                        <Label Text="{Binding GroupChat.GroupTitle}" FontSize="15" FontAttributes="Bold" MaxLines="1" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding GroupChat.GroupSubtitle}" FontSize="11" TextColor="{StaticResource TextTertiary}" MaxLines="1" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Grid>
                <Border Grid.Column="3" AutomationId="DesktopWorkspace.MessageSearchButton" WidthRequest="40" HeightRequest="40" Background="Transparent" StrokeThickness="0" SemanticProperties.Description="Поиск в чате" IsVisible="{Binding HasSelectedDetail}">
                    <Path Data="M10,4 A6,6 0 1 0 10,16 A6,6 0 1 0 10,4 M14.5,14.5 L20,20" Stroke="{StaticResource TextSecondary}" StrokeThickness="2" Fill="Transparent" WidthRequest="22" HeightRequest="22" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnMessageSearchClicked" /></Border.GestureRecognizers>
                </Border>
                <Border Grid.Column="4" AutomationId="DesktopWorkspace.AudioCall" WidthRequest="40" HeightRequest="40" Background="Transparent" StrokeThickness="0" SemanticProperties.Description="Аудиозвонок" IsEnabled="{Binding IsDirectDetail}" IsVisible="{Binding HasSelectedDetail}">
                    <Path Data="M7,3 L10,8 L7,10 C9,14 12,17 16,19 L18,16 L23,19 C22,22 20,24 17,23 C9,20 4,15 2,7 C1,4 4,2 7,3 Z" Stroke="{StaticResource PrimaryColor}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="22" HeightRequest="22" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAudioCallClicked" /></Border.GestureRecognizers>
                </Border>
                <Border Grid.Column="5" AutomationId="DesktopWorkspace.VideoCall" WidthRequest="40" HeightRequest="40" Background="Transparent" StrokeThickness="0" SemanticProperties.Description="Видеозвонок" IsEnabled="{Binding IsDirectDetail}" IsVisible="{Binding HasSelectedDetail}">
                    <Path Data="M3,6 H16 V18 H3 Z M16,10 L22,7 V17 L16,14 Z" Stroke="{StaticResource PrimaryColor}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="23" HeightRequest="23" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnVideoCallClicked" /></Border.GestureRecognizers>
                </Border>
                <Button Grid.Column="6" AutomationId="DesktopWorkspace.Overflow" Text="⋯" Style="{StaticResource ToolbarIconButton}" SemanticProperties.Description="Дополнительно" Clicked="OnOverflowClicked" IsVisible="{Binding HasSelectedDetail}" />
            </Grid>

            <Grid x:Name="MessageSearchBar" AutomationId="DesktopWorkspace.MessageSearch" Grid.Row="1" HeightRequest="44" Padding="10,3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" BackgroundColor="{StaticResource PageBackground}" IsVisible="False">
                <Entry x:Name="MessageSearchEntry" Placeholder="Поиск в сообщениях" TextChanged="OnMessageSearchTextChanged" BackgroundColor="{StaticResource SearchBackground}" />
                <Button Grid.Column="1" Text="↑" Style="{StaticResource GhostButton}" WidthRequest="38" Padding="0" Clicked="OnPreviousSearchResultClicked" />
                <Button Grid.Column="2" Text="↓" Style="{StaticResource GhostButton}" WidthRequest="38" Padding="0" Clicked="OnNextSearchResultClicked" />
            </Grid>

            <Grid x:Name="DetailContent" Grid.Row="2">
                <Border Margin="12,8" Padding="10,7" VerticalOptions="Start" HorizontalOptions="Fill" ZIndex="50" Background="{StaticResource PanelBackgroundAlt}" Stroke="{StaticResource DangerColor}" StrokeThickness="1" StrokeShape="RoundRectangle 6" IsVisible="{Binding HasError}">
                    <Label Text="{Binding ErrorMessage}" FontSize="12" TextColor="{StaticResource DangerColor}" LineBreakMode="WordWrap" />
                </Border>
                <Grid AutomationId="DesktopWorkspace.EmptyDetail" IsVisible="{Binding IsEmptyDetail}">
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                        <Label Text="Deep" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="Выберите диалог" FontSize="13" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>

                <Grid AutomationId="DesktopWorkspace.DirectDetail" RowDefinitions="*,Auto" IsVisible="{Binding IsDirectDetail}">
                    <CollectionView
                        x:Name="DirectMessagesCollection"
                        AutomationId="DesktopWorkspace.DirectMessages"
                        ItemsSource="{Binding DirectChat.Messages}"
                        SelectionMode="None"
                        ItemsUpdatingScrollMode="KeepLastItemInView">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChatMessageItem">
                                <Border Margin="12,3" Padding="10,7" MaximumWidthRequest="620" HorizontalOptions="Start" Background="{StaticResource IncomingBubbleColor}" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                                    <Border.Behaviors>
                                        <controls:MessageContextGestureBehavior Invoked="OnDirectMessageContextRequested" />
                                    </Border.Behaviors>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsOutgoing}" Value="True">
                                            <Setter Property="HorizontalOptions" Value="End" />
                                            <Setter Property="Background" Value="{StaticResource OutgoingBubbleColor}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <VerticalStackLayout Spacing="5">
                                        <Border Padding="8,5" Background="{StaticResource PanelBackgroundAlt}" StrokeThickness="0" StrokeShape="RoundRectangle 4" IsVisible="{Binding HasReply}">
                                            <Label Text="{Binding ReplyPreview}" FontSize="12" TextColor="{StaticResource TextSecondary}" MaxLines="2" LineBreakMode="TailTruncation" />
                                        </Border>
                                        <Grid ColumnDefinitions="38,*" ColumnSpacing="9" MinimumWidthRequest="190" IsVisible="{Binding IsVoiceMessage}">
                                            <Border AutomationId="DesktopWorkspace.DirectVoicePlay" WidthRequest="36" HeightRequest="36" Background="{StaticResource PrimaryColor}" StrokeThickness="0" StrokeShape="RoundRectangle 18" VerticalOptions="Center">
                                                <Grid WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center">
                                                    <Path Data="M10,7 L23,18 L10,29 Z" Fill="#020711" WidthRequest="18" HeightRequest="18" Aspect="Uniform" IsVisible="{Binding IsVoiceIdle}" />
                                                    <Path Data="M8,6 H11 V22 H8 Z M17,6 H20 V22 H17 Z" Fill="#020711" WidthRequest="18" HeightRequest="18" Aspect="Uniform" IsVisible="{Binding IsVoicePlaying}" />
                                                </Grid>
                                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDirectVoiceMessageTapped" /></Border.GestureRecognizers>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                                <ProgressBar Progress="{Binding VoicePlaybackProgress}" HeightRequest="3" ProgressColor="{StaticResource PrimaryColor}" BackgroundColor="{StaticResource DividerColor}" />
                                                <Label Text="{Binding VoicePlaybackLabel}" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                        <Image Source="{Binding ImagePreviewPath}" IsVisible="{Binding HasImagePreview}" WidthRequest="{Binding ImagePreviewWidthRequest}" HeightRequest="{Binding ImagePreviewHeightRequest}" MaximumWidthRequest="420" MaximumHeightRequest="320" Aspect="AspectFill">
                                            <Image.GestureRecognizers><TapGestureRecognizer Tapped="OnDirectAttachmentTapped" /></Image.GestureRecognizers>
                                        </Image>
                                        <Label Text="{Binding AttachmentSummary}" FontSize="12" TextColor="{StaticResource TextSecondary}" IsVisible="{Binding HasNonVoiceAttachments}">
                                            <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnDirectAttachmentTapped" /></Label.GestureRecognizers>
                                        </Label>
                                        <Label Text="{Binding Body}" FontSize="14" LineBreakMode="WordWrap" IsVisible="{Binding HasVisibleBody}" />
                                        <FlexLayout BindableLayout.ItemsSource="{Binding ReactionChips}" Direction="Row" Wrap="Wrap" AlignItems="Start" IsVisible="{Binding HasReactions}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:MessageReactionChip">
                                                    <Border Style="{StaticResource ReactionChip}" Margin="0,2,4,0">
                                                        <HorizontalStackLayout Spacing="4"><Label Text="{Binding Emoji}" FontSize="12" /><Label Text="{Binding Count}" FontSize="11" /></HorizontalStackLayout>
                                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDirectReactionChipTapped" /></Border.GestureRecognizers>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </FlexLayout>
                                        <HorizontalStackLayout HorizontalOptions="End" Spacing="5">
                                            <Label Text="{Binding LocalCreatedAt, StringFormat='{}{0:HH:mm}'}" FontSize="10" TextColor="{StaticResource TextTertiary}" />
                                            <Label Text="{Binding StatusGlyph}" FontSize="10" TextColor="{StaticResource PrimaryColor}" IsVisible="{Binding IsStatusVisible}" SemanticProperties.Description="{Binding StatusDescription}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <VerticalStackLayout Grid.Row="1" Spacing="0" BackgroundColor="{StaticResource PageBackground}">
                        <Grid Padding="12,6" ColumnDefinitions="*,Auto" BackgroundColor="{StaticResource PanelBackgroundAlt}" IsVisible="{Binding DirectChat.IsReplying}">
                            <VerticalStackLayout Spacing="1"><Label Text="Ответ" FontSize="11" TextColor="{StaticResource PrimaryColor}" /><Label Text="{Binding DirectChat.ReplyingToPreview}" FontSize="12" MaxLines="1" LineBreakMode="TailTruncation" /></VerticalStackLayout>
                            <Button Grid.Column="1" Text="×" Style="{StaticResource GhostButton}" WidthRequest="34" Padding="0" Command="{Binding DirectChat.CancelReplyCommand}" />
                        </Grid>
                        <Grid Padding="12,5" ColumnDefinitions="*,Auto" BackgroundColor="{StaticResource PanelBackgroundAlt}" IsVisible="{Binding DirectChat.HasStagedAttachments}">
                            <Label Text="{Binding DirectChat.StagedAttachmentSummary}" FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="×" Style="{StaticResource GhostButton}" WidthRequest="34" Padding="0" Command="{Binding DirectChat.ClearAttachmentsCommand}" />
                        </Grid>
                        <Border x:Name="DirectVoiceRecordingPanel" Style="{StaticResource VoiceRecordingPanel}" IsVisible="{Binding DirectChat.IsRecordingVoice}">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="9">
                                <Border WidthRequest="10" HeightRequest="10" Background="{StaticResource DangerColor}" StrokeThickness="0" StrokeShape="RoundRectangle 5" VerticalOptions="Center" />
                                <Label x:Name="DirectVoiceElapsedLabel" Grid.Column="1" Text="00:00" FontSize="14" VerticalTextAlignment="Center" />
                                <Label x:Name="DirectVoiceSlideHintLabel" Grid.Column="2" Text="Сдвиньте влево для отмены" FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalTextAlignment="Center" />
                                <Border x:Name="DirectVoiceCancelPill" Grid.Column="3" Padding="10,5" StrokeThickness="0" Background="{StaticResource PanelBackgroundAlt}" StrokeShape="RoundRectangle 14"><Label Text="Отмена" FontSize="12" TextColor="{StaticResource TextSecondary}" /></Border>
                            </Grid>
                        </Border>
                        <Grid Padding="8,7" ColumnDefinitions="42,*,42" ColumnSpacing="7">
                            <Button AutomationId="DesktopWorkspace.DirectAttach" Text="+" Style="{StaticResource ToolbarIconButton}" FontSize="25" Command="{Binding DirectChat.PickAttachmentsCommand}" SemanticProperties.Description="Добавить вложение" />
                            <Editor x:Name="DirectDraftEditor" Grid.Column="1" AutomationId="DesktopWorkspace.DirectDraft" Text="{Binding DirectChat.Draft}" Placeholder="Сообщение" AutoSize="TextChanges" MinimumHeightRequest="42" MaximumHeightRequest="116" BackgroundColor="{StaticResource SearchBackground}" />
                            <Button Grid.Column="2" AutomationId="DesktopWorkspace.DirectSend" Text="→" Style="{StaticResource ToolbarIconButton}" BackgroundColor="{StaticResource PrimaryColor}" TextColor="#03101A" Command="{Binding DirectChat.SendCommand}" SemanticProperties.Description="Отправить" IsVisible="{Binding DirectChat.ShowSendButton}" />
                            <Border x:Name="DirectVoiceButton" Grid.Column="2" AutomationId="DesktopWorkspace.DirectVoice" Style="{StaticResource ComposerPrimarySurface}" SemanticProperties.Description="Голосовое сообщение" IsVisible="{Binding DirectChat.ShowVoiceButton}">
                                <Path Data="M12,4 C10.3,4 9,5.3 9,7 V12 C9,13.7 10.3,15 12,15 C13.7,15 15,13.7 15,12 V7 C15,5.3 13.7,4 12,4 Z M6,11 C6,14.3 8.7,17 12,17 C15.3,17 18,14.3 18,11 M12,17 V21 M9,21 H15" Stroke="#020711" StrokeThickness="2" Fill="Transparent" WidthRequest="23" HeightRequest="23" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Border.GestureRecognizers><PointerGestureRecognizer PointerPressed="OnVoicePointerPressed" PointerMoved="OnVoicePointerMoved" PointerReleased="OnVoicePointerReleased" /></Border.GestureRecognizers>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Grid>

                <Grid AutomationId="DesktopWorkspace.GroupDetail" RowDefinitions="*,Auto" IsVisible="{Binding IsGroupDetail}">
                    <CollectionView
                        x:Name="GroupMessagesCollection"
                        AutomationId="DesktopWorkspace.GroupMessages"
                        ItemsSource="{Binding GroupChat.Messages}"
                        SelectionMode="None"
                        ItemsUpdatingScrollMode="KeepLastItemInView">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:GroupChatMessageItem">
                                <Border Margin="12,3" Padding="10,7" MaximumWidthRequest="620" HorizontalOptions="Start" Background="{StaticResource IncomingBubbleColor}" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                                    <Border.Behaviors>
                                        <controls:MessageContextGestureBehavior Invoked="OnGroupMessageContextRequested" />
                                    </Border.Behaviors>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsOutgoing}" Value="True">
                                            <Setter Property="HorizontalOptions" Value="End" />
                                            <Setter Property="Background" Value="{StaticResource OutgoingBubbleColor}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="{Binding SenderLabel}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" IsVisible="{Binding ShowSenderLabel}" />
                                        <Border Padding="8,5" Background="{StaticResource PanelBackgroundAlt}" StrokeThickness="0" StrokeShape="RoundRectangle 4" IsVisible="{Binding HasReply}"><Label Text="{Binding ReplyPreview}" FontSize="12" TextColor="{StaticResource TextSecondary}" MaxLines="2" LineBreakMode="TailTruncation" /></Border>
                                        <Grid ColumnDefinitions="38,*" ColumnSpacing="9" MinimumWidthRequest="190" IsVisible="{Binding IsVoiceMessage}">
                                            <Border AutomationId="DesktopWorkspace.GroupVoicePlay" WidthRequest="36" HeightRequest="36" Background="{StaticResource PrimaryColor}" StrokeThickness="0" StrokeShape="RoundRectangle 18" VerticalOptions="Center">
                                                <Grid WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center">
                                                    <Path Data="M10,7 L23,18 L10,29 Z" Fill="#020711" WidthRequest="18" HeightRequest="18" Aspect="Uniform" IsVisible="{Binding IsVoiceIdle}" />
                                                    <Path Data="M8,6 H11 V22 H8 Z M17,6 H20 V22 H17 Z" Fill="#020711" WidthRequest="18" HeightRequest="18" Aspect="Uniform" IsVisible="{Binding IsVoicePlaying}" />
                                                </Grid>
                                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnGroupVoiceMessageTapped" /></Border.GestureRecognizers>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                                <ProgressBar Progress="{Binding VoicePlaybackProgress}" HeightRequest="3" ProgressColor="{StaticResource PrimaryColor}" BackgroundColor="{StaticResource DividerColor}" />
                                                <Label Text="{Binding VoicePlaybackLabel}" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                        <Image Source="{Binding ImagePreviewPath}" IsVisible="{Binding HasImagePreview}" WidthRequest="{Binding ImagePreviewWidthRequest}" HeightRequest="{Binding ImagePreviewHeightRequest}" MaximumWidthRequest="420" MaximumHeightRequest="320" Aspect="AspectFill">
                                            <Image.GestureRecognizers><TapGestureRecognizer Tapped="OnGroupAttachmentTapped" /></Image.GestureRecognizers>
                                        </Image>
                                        <Label Text="{Binding AttachmentSummary}" FontSize="12" TextColor="{StaticResource TextSecondary}" IsVisible="{Binding HasNonVoiceAttachments}"><Label.GestureRecognizers><TapGestureRecognizer Tapped="OnGroupAttachmentTapped" /></Label.GestureRecognizers></Label>
                                        <Label Text="{Binding Body}" FontSize="14" LineBreakMode="WordWrap" IsVisible="{Binding HasVisibleBody}" />
                                        <FlexLayout BindableLayout.ItemsSource="{Binding ReactionChips}" Direction="Row" Wrap="Wrap" AlignItems="Start" IsVisible="{Binding HasReactions}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:MessageReactionChip">
                                                    <Border Style="{StaticResource ReactionChip}" Margin="0,2,4,0">
                                                        <HorizontalStackLayout Spacing="4"><Label Text="{Binding Emoji}" FontSize="12" /><Label Text="{Binding Count}" FontSize="11" /></HorizontalStackLayout>
                                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnGroupReactionChipTapped" /></Border.GestureRecognizers>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </FlexLayout>
                                        <HorizontalStackLayout HorizontalOptions="End" Spacing="5"><Label Text="{Binding LocalCreatedAt, StringFormat='{}{0:HH:mm}'}" FontSize="10" TextColor="{StaticResource TextTertiary}" /><Label Text="{Binding StatusGlyph}" FontSize="10" TextColor="{StaticResource PrimaryColor}" IsVisible="{Binding IsStatusVisible}" SemanticProperties.Description="{Binding StatusDescription}" /></HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <VerticalStackLayout Grid.Row="1" Spacing="0" BackgroundColor="{StaticResource PageBackground}">
                        <Grid Padding="12,6" ColumnDefinitions="*,Auto" BackgroundColor="{StaticResource PanelBackgroundAlt}" IsVisible="{Binding GroupChat.IsReplying}"><VerticalStackLayout Spacing="1"><Label Text="Ответ" FontSize="11" TextColor="{StaticResource PrimaryColor}" /><Label Text="{Binding GroupChat.ReplyingToPreview}" FontSize="12" MaxLines="1" LineBreakMode="TailTruncation" /></VerticalStackLayout><Button Grid.Column="1" Text="×" Style="{StaticResource GhostButton}" WidthRequest="34" Padding="0" Command="{Binding GroupChat.CancelReplyCommand}" /></Grid>
                        <Grid Padding="12,5" ColumnDefinitions="*,Auto" BackgroundColor="{StaticResource PanelBackgroundAlt}" IsVisible="{Binding GroupChat.HasStagedAttachments}"><Label Text="{Binding GroupChat.StagedAttachmentSummary}" FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" /><Button Grid.Column="1" Text="×" Style="{StaticResource GhostButton}" WidthRequest="34" Padding="0" Command="{Binding GroupChat.ClearAttachmentsCommand}" /></Grid>
                        <Border x:Name="GroupVoiceRecordingPanel" Style="{StaticResource VoiceRecordingPanel}" IsVisible="{Binding GroupChat.IsRecordingVoice}">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="9">
                                <Border WidthRequest="10" HeightRequest="10" Background="{StaticResource DangerColor}" StrokeThickness="0" StrokeShape="RoundRectangle 5" VerticalOptions="Center" />
                                <Label x:Name="GroupVoiceElapsedLabel" Grid.Column="1" Text="00:00" FontSize="14" VerticalTextAlignment="Center" />
                                <Label x:Name="GroupVoiceSlideHintLabel" Grid.Column="2" Text="Сдвиньте влево для отмены" FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalTextAlignment="Center" />
                                <Border x:Name="GroupVoiceCancelPill" Grid.Column="3" Padding="10,5" StrokeThickness="0" Background="{StaticResource PanelBackgroundAlt}" StrokeShape="RoundRectangle 14"><Label Text="Отмена" FontSize="12" TextColor="{StaticResource TextSecondary}" /></Border>
                            </Grid>
                        </Border>
                        <Grid Padding="8,7" ColumnDefinitions="42,*,42" ColumnSpacing="7">
                            <Button AutomationId="DesktopWorkspace.GroupAttach" Text="+" Style="{StaticResource ToolbarIconButton}" FontSize="25" Command="{Binding GroupChat.PickAttachmentsCommand}" SemanticProperties.Description="Добавить вложение" />
                            <Editor x:Name="GroupDraftEditor" Grid.Column="1" AutomationId="DesktopWorkspace.GroupDraft" Text="{Binding GroupChat.Draft}" Placeholder="Сообщение" AutoSize="TextChanges" MinimumHeightRequest="42" MaximumHeightRequest="116" BackgroundColor="{StaticResource SearchBackground}" />
                            <Button Grid.Column="2" AutomationId="DesktopWorkspace.GroupSend" Text="→" Style="{StaticResource ToolbarIconButton}" BackgroundColor="{StaticResource PrimaryColor}" TextColor="#03101A" Command="{Binding GroupChat.SendCommand}" SemanticProperties.Description="Отправить" IsVisible="{Binding GroupChat.ShowSendButton}" />
                            <Border x:Name="GroupVoiceButton" Grid.Column="2" AutomationId="DesktopWorkspace.GroupVoice" Style="{StaticResource ComposerPrimarySurface}" SemanticProperties.Description="Голосовое сообщение" IsVisible="{Binding GroupChat.ShowVoiceButton}">
                                <Path Data="M12,4 C10.3,4 9,5.3 9,7 V12 C9,13.7 10.3,15 12,15 C13.7,15 15,13.7 15,12 V7 C15,5.3 13.7,4 12,4 Z M6,11 C6,14.3 8.7,17 12,17 C15.3,17 18,14.3 18,11 M12,17 V21 M9,21 H15" Stroke="#020711" StrokeThickness="2" Fill="Transparent" WidthRequest="23" HeightRequest="23" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Border.GestureRecognizers><PointerGestureRecognizer PointerPressed="OnVoicePointerPressed" PointerMoved="OnVoicePointerMoved" PointerReleased="OnVoicePointerReleased" /></Border.GestureRecognizers>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Grid>

                <Border
                    x:Name="HeaderOverflowMenu"
                    AutomationId="DesktopWorkspace.HeaderOverflowMenu"
                    WidthRequest="210"
                    Margin="0,8,12,0"
                    Padding="5"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    ZIndex="30"
                    Background="{StaticResource PanelBackgroundAlt}"
                    Stroke="{StaticResource DividerColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 6"
                    IsVisible="False">
                    <VerticalStackLayout Spacing="0">
                        <Button Text="Участники группы" Style="{StaticResource GhostButton}" HorizontalOptions="Fill" Clicked="OnGroupMembersClicked" IsVisible="{Binding IsGroupDetail}" />
                        <Button Text="Обновить чат" Style="{StaticResource GhostButton}" HorizontalOptions="Fill" Clicked="OnRefreshChatClicked" />
                        <Button Text="Закрыть меню" Style="{StaticResource GhostButton}" HorizontalOptions="Fill" Clicked="OnCloseOverflowClicked" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    x:Name="GroupMembersPanel"
                    AutomationId="DesktopWorkspace.GroupMembersPanel"
                    WidthRequest="360"
                    Margin="0,8,12,12"
                    Padding="12"
                    HorizontalOptions="End"
                    VerticalOptions="Fill"
                    ZIndex="35"
                    Background="{StaticResource PageBackground}"
                    Stroke="{StaticResource DividerColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 6"
                    IsVisible="False">
                    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="Участники" FontSize="17" FontAttributes="Bold" />
                                <Label Text="{Binding GroupChat.GroupSubtitle}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="×" Style="{StaticResource ToolbarIconButton}" Clicked="OnCloseGroupMembersClicked" SemanticProperties.Description="Закрыть список участников" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding GroupChat.CanManageMembers}">
                            <Entry AutomationId="DesktopWorkspace.GroupMemberId" Placeholder="ID аккаунта" Text="{Binding GroupChat.MemberSessionId}" BackgroundColor="{StaticResource SearchBackground}" />
                            <Button Grid.Column="1" Text="Добавить" Command="{Binding GroupChat.AddMemberCommand}" />
                        </Grid>
                        <CollectionView
                            Grid.Row="2"
                            AutomationId="DesktopWorkspace.GroupMembers"
                            ItemsSource="{Binding GroupChat.Members}"
                            SelectedItem="{Binding GroupChat.SelectedMember, Mode=TwoWay}"
                            SelectionMode="Single">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:GroupMemberItem">
                                    <Grid Padding="6,8" ColumnDefinitions="40,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                                        <Border Grid.RowSpan="2" WidthRequest="38" HeightRequest="38" Padding="0" StrokeThickness="0" Background="{StaticResource PrimaryColorMuted}" StrokeShape="RoundRectangle 19">
                                            <Label Text="{Binding AvatarInitial}" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <Label Grid.Column="1" Text="{Binding DisplayName}" FontSize="14" FontAttributes="Bold" MaxLines="1" LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="2" Text="{Binding RoleLabel}" FontSize="11" TextColor="{StaticResource PrimaryColor}" />
                                        <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding PendingRemovalLabel}" FontSize="11" TextColor="{StaticResource DangerColor}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Grid Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="6" IsVisible="{Binding GroupChat.CanManageMembers}">
                            <Button Text="Повысить" Style="{StaticResource GhostButton}" Command="{Binding GroupChat.PromoteMemberCommand}" />
                            <Button Grid.Column="1" Text="Понизить" Style="{StaticResource GhostButton}" Command="{Binding GroupChat.DemoteMemberCommand}" />
                            <Button Grid.Column="2" Text="Удалить" Style="{StaticResource GhostButton}" TextColor="{StaticResource DangerColor}" Command="{Binding GroupChat.RemoveMemberCommand}" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    x:Name="DesktopMessageContextMenu"
                    AutomationId="DesktopWorkspace.MessageContextMenu"
                    WidthRequest="248"
                    Margin="0,8,12,0"
                    Padding="6"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    ZIndex="40"
                    Background="{StaticResource PanelBackgroundAlt}"
                    Stroke="{StaticResource DividerColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 6"
                    IsVisible="False">
                    <VerticalStackLayout Spacing="2">
                        <HorizontalStackLayout Spacing="3" HorizontalOptions="Center">
                            <Button Text="👍" CommandParameter="👍" Style="{StaticResource ReactionPickerButton}" Clicked="OnContextReactionClicked" />
                            <Button Text="❤️" CommandParameter="❤️" Style="{StaticResource ReactionPickerButton}" Clicked="OnContextReactionClicked" />
                            <Button Text="😂" CommandParameter="😂" Style="{StaticResource ReactionPickerButton}" Clicked="OnContextReactionClicked" />
                            <Button Text="😮" CommandParameter="😮" Style="{StaticResource ReactionPickerButton}" Clicked="OnContextReactionClicked" />
                            <Button Text="😢" CommandParameter="😢" Style="{StaticResource ReactionPickerButton}" Clicked="OnContextReactionClicked" />
                        </HorizontalStackLayout>
                        <Button Text="Ответить" Style="{StaticResource GhostButton}" HorizontalOptions="Fill" Clicked="OnContextReplyClicked" />
                        <Button x:Name="CopyMessageButton" Text="Копировать" Style="{StaticResource GhostButton}" HorizontalOptions="Fill" Clicked="OnContextCopyClicked" />
                        <Button x:Name="OpenAttachmentButton" Text="Открыть вложение" Style="{StaticResource GhostButton}" HorizontalOptions="Fill" Clicked="OnContextOpenAttachmentClicked" />
                        <Button x:Name="SaveAttachmentButton" Text="Сохранить как..." Style="{StaticResource GhostButton}" HorizontalOptions="Fill" Clicked="OnContextSaveAttachmentClicked" />
                        <Button x:Name="ShareAttachmentButton" Text="Поделиться" Style="{StaticResource GhostButton}" HorizontalOptions="Fill" Clicked="OnContextShareAttachmentClicked" />
                        <Button x:Name="CopyAttachmentNameButton" Text="Копировать имя файла" Style="{StaticResource GhostButton}" HorizontalOptions="Fill" Clicked="OnContextCopyAttachmentNameClicked" />
                        <Button Text="Удалить" Style="{StaticResource GhostButton}" TextColor="{StaticResource DangerColor}" HorizontalOptions="Fill" Clicked="OnContextDeleteClicked" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
