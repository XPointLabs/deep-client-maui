<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Deep.Client.Maui.Pages.ConversationsPage"
    AutomationId="Page.Conversations"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Deep.Client.Maui.Core.ViewModels;assembly=Deep.Client.Maui.Core"
    x:DataType="vm:ConversationsViewModel"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.NavBarIsVisible="False"
    Title="Диалоги">
    <Grid x:Name="RootLayout" AutomationId="Conversations.Root" RowDefinitions="Auto,Auto,Auto,*" BackgroundColor="{StaticResource PageBackground}">
        <Border x:Name="NetworkBanner" Grid.Row="0" Padding="12,7" IsVisible="False" Background="{StaticResource PanelBackground}" StrokeThickness="0">
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Border WidthRequest="7" HeightRequest="7" StrokeThickness="0" Background="{StaticResource DangerColor}" StrokeShape="RoundRectangle 4" VerticalOptions="Center" />
                <Label x:Name="NetworkBannerText" Text="Нет соединения" FontSize="12" TextColor="{StaticResource DangerColor}" />
            </HorizontalStackLayout>
        </Border>

        <Grid x:Name="HeaderBar" Grid.Row="1" Style="{StaticResource CompactHeader}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Grid WidthRequest="42" HeightRequest="42" VerticalOptions="Center">
                <Border WidthRequest="40" HeightRequest="40" Padding="0" StrokeThickness="0" Background="{StaticResource AvatarAccentColor}" HorizontalOptions="Center" VerticalOptions="Center" StrokeShape="RoundRectangle 20">
                    <Grid>
                        <Image x:Name="ProfileAvatarImage" Aspect="AspectFill" IsVisible="False" />
                        <Label x:Name="ProfileInitialLabel" Text="{Binding AccountInitial}" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" FontSize="16" FontAutoScalingEnabled="False" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileClicked" />
                    </Border.GestureRecognizers>
                </Border>
                <Border x:Name="ProfileStatusDot" WidthRequest="10" HeightRequest="10" Stroke="{StaticResource PageBackground}" StrokeThickness="2" Background="{StaticResource PrimaryColor}" HorizontalOptions="End" VerticalOptions="End" StrokeShape="RoundRectangle 5" Margin="0,0,1,1" />
            </Grid>
            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                <Label Text="Deep" FontSize="20" FontAttributes="Bold" VerticalTextAlignment="Center" />
                <Label Text="через XPoint Network" FontSize="11" TextColor="{StaticResource TextTertiary}" Margin="0,-2,0,0" />
            </VerticalStackLayout>
            <Border Grid.Column="2" AutomationId="Conversations.NewConversationTop" WidthRequest="42" HeightRequest="42" Background="Transparent" StrokeThickness="0" SemanticProperties.Description="Новое сообщение" VerticalOptions="Center">
                <Path Data="M12,5 V19 M5,12 H19" Stroke="{StaticResource PrimaryColor}" StrokeThickness="2.4" StrokeLineCap="Round" Fill="Transparent" WidthRequest="24" HeightRequest="24" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNewConversationClicked" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource SearchBorder}" Margin="12,4,12,8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                <Grid WidthRequest="20" HeightRequest="20" VerticalOptions="Center">
                    <Ellipse WidthRequest="12" HeightRequest="12" Stroke="{StaticResource TextSecondary}" StrokeThickness="2" HorizontalOptions="Start" VerticalOptions="Start" Margin="1,1,0,0" />
                    <Line X1="11" Y1="11" X2="18" Y2="18" Stroke="{StaticResource TextSecondary}" StrokeThickness="2" StrokeLineCap="Round" />
                </Grid>
                <Entry x:Name="SearchEntry" AutomationId="Conversations.Search" Grid.Column="1" Placeholder="Поиск" Text="{Binding SearchQuery}" HeightRequest="38" Margin="0" BackgroundColor="Transparent" />
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <RefreshView
                AutomationId="Conversations.Refresh"
                IsRefreshing="{Binding IsManualRefreshing, Mode=OneWay}"
                Command="{Binding ManualRefreshCommand}"
                RefreshColor="{StaticResource PrimaryColor}">
              <CollectionView
                    AutomationId="Conversations.List"
                    ItemsSource="{Binding Conversations}"
                    ItemSizingStrategy="MeasureFirstItem"
                    SelectionMode="Single"
                    SelectedItem="{Binding SelectedConversation, Mode=TwoWay}">
                    <CollectionView.EmptyView>
                        <Grid Padding="50,88,50,0">
                            <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Start">
                                <Border WidthRequest="70" HeightRequest="70" StrokeThickness="1" Stroke="{StaticResource PrimaryColor}" Background="{StaticResource PanelBackground}" StrokeShape="RoundRectangle 35">
                                    <Label Text="X" FontSize="36" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <Label Text="Пока нет диалогов" FontSize="17" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                <Label Text="Нажмите +, чтобы начать переписку или создать группу." FontSize="13" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConversationListItem">
                            <Border x:Name="RowCard" Style="{StaticResource ConversationRowBorder}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnConversationTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="11" RowSpacing="2" HeightRequest="60">
                                    <Border Grid.RowSpan="2" WidthRequest="52" HeightRequest="52" Padding="0" StrokeThickness="0" Background="{StaticResource PrimaryColorMuted}" VerticalOptions="Center" StrokeShape="RoundRectangle 26">
                                        <Label Text="{Binding AvatarInitial}" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" FontSize="19" />
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding Title}" FontSize="16" FontAttributes="Bold" LineBreakMode="TailTruncation" VerticalOptions="End" MaxLines="1" />
                                    <Label Grid.Column="2" Text="{Binding UpdatedAt, StringFormat='{}{0:HH:mm}'}" FontSize="12" TextColor="{StaticResource TextTertiary}" VerticalOptions="End" />
                                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5">
                                            <Label Text="Запрос" FontSize="13" TextColor="{StaticResource PrimaryColor}" FontAttributes="Bold" IsVisible="{Binding IsMessageRequest}" />
                                            <Label Grid.Column="1" Text="{Binding LastMessagePreview}" FontSize="14" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" MaxLines="1" />
                                            <Path Grid.Column="2" Data="M4,12 L9,17 L20,6" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Fill="Transparent" WidthRequest="16" HeightRequest="16" Aspect="Uniform" IsVisible="{Binding IsMuted}" />
                                        </Grid>
                                        <Border Grid.Column="1" Background="{StaticResource PrimaryColor}" MinimumWidthRequest="20" HeightRequest="20" Padding="6,0" StrokeThickness="0" StrokeShape="RoundRectangle 10" IsVisible="True">
                                            <Label Text="{Binding UnreadCount}" FontSize="11" TextColor="#03101A" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding UnreadCount}" Value="0"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                            </Border.Triggers>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
              </CollectionView>
            </RefreshView>

        </Grid>
    </Grid>
</ContentPage>
