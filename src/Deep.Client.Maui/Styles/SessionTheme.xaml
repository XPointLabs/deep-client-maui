<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Color x:Key="PageBackground">#050A13</Color>
    <Color x:Key="PanelBackground">#0B1422</Color>
    <Color x:Key="PanelBackgroundAlt">#111E31</Color>
    <Color x:Key="PrimaryColor">#18C8F4</Color>
    <Color x:Key="PrimaryColorMuted">#176FF2</Color>
    <Color x:Key="AvatarAccentColor">#2C7BFF</Color>
    <Color x:Key="TextPrimary">#F7FAFF</Color>
    <Color x:Key="TextSecondary">#91A4BA</Color>
    <Color x:Key="TextTertiary">#60748B</Color>
    <Color x:Key="DangerColor">#FF8B8B</Color>
    <Color x:Key="IncomingBubbleColor">#111C2B</Color>
    <Color x:Key="OutgoingBubbleColor">#123461</Color>
    <Color x:Key="DividerColor">#1A2A3E</Color>
    <Color x:Key="SearchBackground">#111B29</Color>
    <Color x:Key="PressedBackground">#15243A</Color>

    <Thickness x:Key="PagePadding">16,6,16,10</Thickness>

    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{StaticResource PageBackground}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontAutoScalingEnabled" Value="False" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="BackgroundColor" Value="{StaticResource PanelBackgroundAlt}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="FontAutoScalingEnabled" Value="False" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="BackgroundColor" Value="{StaticResource PanelBackgroundAlt}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAutoScalingEnabled" Value="False" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
        <Setter Property="TextColor" Value="#020711" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontAutoScalingEnabled" Value="False" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PanelBackgroundAlt}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="FabButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
        <Setter Property="TextColor" Value="#020711" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontAutoScalingEnabled" Value="False" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="PanelBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBackground}" />
        <Setter Property="Stroke" Value="{StaticResource DividerColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="8" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScreenSurface" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PageBackground}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="0" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ConversationRowBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PageBackground}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="0" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CompactHeader" TargetType="Grid">
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="BackgroundColor" Value="{StaticResource PageBackground}" />
    </Style>

    <Style x:Key="SearchBorder" TargetType="Border">
        <Setter Property="HeightRequest" Value="38" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="{StaticResource SearchBackground}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="10" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CircularIconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="21" />
    </Style>

    <Style x:Key="SettingsSection" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBackground}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ContextMenuBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBackground}" />
        <Setter Property="Stroke" Value="{StaticResource DividerColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="StrokeShape">
            <Setter.Value><RoundRectangle CornerRadius="14" /></Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ReactionPickerButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="WidthRequest" Value="43" />
        <Setter Property="HeightRequest" Value="43" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontAttributes" Value="None" />
    </Style>

    <Style x:Key="ReactionChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBackgroundAlt}" />
        <Setter Property="Stroke" Value="{StaticResource DividerColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="StrokeShape">
            <Setter.Value><RoundRectangle CornerRadius="12" /></Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComposerIconSurface" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="WidthRequest" Value="42" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value><RoundRectangle CornerRadius="21" /></Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComposerPrimarySurface" TargetType="Border" BasedOn="{StaticResource ComposerIconSurface}">
        <Setter Property="Background" Value="{StaticResource PrimaryColor}" />
    </Style>

    <Style x:Key="AttachmentCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBackgroundAlt}" />
        <Setter Property="Stroke" Value="{StaticResource DividerColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="StrokeShape">
            <Setter.Value><RoundRectangle CornerRadius="12" /></Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AttachmentSheetBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBackground}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="16,10,16,18" />
        <Setter Property="StrokeShape">
            <Setter.Value><RoundRectangle CornerRadius="22,22,0,0" /></Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AttachSheetIcon" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBackgroundAlt}" />
        <Setter Property="Stroke" Value="{StaticResource DividerColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="WidthRequest" Value="52" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value><RoundRectangle CornerRadius="26" /></Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolbarIconButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontAutoScalingEnabled" Value="False" />
    </Style>

    <Style x:Key="SettingsRowBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PageBackground}" />
        <Setter Property="Stroke" Value="{StaticResource DividerColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="0,14" />
    </Style>

</ResourceDictionary>
